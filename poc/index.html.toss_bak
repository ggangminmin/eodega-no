          <button class="onb-chip" type="button" role="button" data-interest="family" aria-pressed="false">가족</button>
          <button class="onb-chip" type="button" role="button" data-interest="couple" aria-pressed="false">커플</button>
          <button class="onb-chip" type="button" role="button" data-interest="solo" aria-pressed="false">혼행</button>
