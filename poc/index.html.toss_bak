  <script>
    const TOUR_API_KEY = 'cu6+0yMVqXnkE8TFlk4H1yA4ie+/i7jX5/udz/qYY7SUPWVzQRVvNBtIEpGa4/GliSmqNDo/jTvS6Q+5P42Lbg==';
    const BASE_URL = 'https://apis.data.go.kr/B551011/KorService2';
    // Naver proxy - tries multiple endpoints (local dev → deployed serverless)
    const NAVER_PROXY_CANDIDATES = [
      'http://localhost:5001/naver',
      // Add your deployed serverless URL here, e.g.:
      // 'https://your-app.vercel.app/api/naver',
    ];
    let NAVER_PROXY = NAVER_PROXY_CANDIDATES[0];
    let _naverProxyResolved = false;

    async function resolveNaverProxy() {
      if (_naverProxyResolved) return NAVER_PROXY;
      for (const url of NAVER_PROXY_CANDIDATES) {
        try {
          const ctrl = new AbortController();
          const timer = setTimeout(() => ctrl.abort(), 3000);
          const res = await fetch(url + '/blog?query=test&display=1', { signal: ctrl.signal });
          clearTimeout(timer);
          if (res.ok) { NAVER_PROXY = url; _naverProxyResolved = true; return url; }
        } catch {}
      }
      _naverProxyResolved = true;
      return NAVER_PROXY;
    }
    const TYPE_NAMES = { '12':'관광지', '14':'문화시설', '15':'축제/행사', '32':'숙박', '39':'음식점' };
    const TYPE_COLORS = { '12':'#2b96ed', '14':'#7c3aed', '15':'#d97706', '32':'#059669', '39':'#dc2626' };
    const TYPE_ICONS = { '12':'🏝', '14':'🎨', '15':'🎪', '32':'🏨', '39':'🍜' };

    // === 부산 방언 스토리텔링 ===
    const DIALECT_PHRASES = [
      '정말 아름다운 곳입니다',
      '한 번 오면 잊지 못할 거예요',
      '부산에 오셨다면 이곳은 꼭 가보세요',
      '야경을 보면 가슴이 뻥 뚫려요',
      '분위기가 정말 색다릅니다',
      '맛이 기가 막힙니다',
      '사진 찍기 좋은 인생샷 명소입니다',
      '한 번 맛보면 반하게 될 거예요',
      '부산 현지인도 자주 찾는 곳이에요',
      '주말에는 관광객이 많이 찾습니다',
      '진짜 부산의 감성이 느껴져요',
      '시원한 바닷바람 쐬기 좋은 곳입니다',
      '하루 종일 있어도 질리지 않아요',
      '이곳은 부산 로컬 맛집입니다',
      '커피 한 잔 하면서 쉬어가세요',
      '아는 사람만 아는 숨은 명소입니다',
      '부산 여행의 필수 코스입니다',
      '한 번 앉으면 일어나기 싫어질 거예요',
      '이곳 야경은 정말 예술입니다',
      '머리 식히며 기분 전환하기 딱 좋아요',
      '이곳은 데이트 코스로 최고입니다',
      '친구들과 함께하면 더 즐거워요',
      '가성비가 정말 좋은 곳입니다',
      '부산만의 진짜 감성을 느낄 수 있어요',
      '해질녘에 방문하면 더욱 좋습니다',
      '부산 여행에서 빼놓을 수 없는 곳!',
      '인생 최고의 뷰를 보장합니다 정말로',
      '시간 가는 줄 모르게 즐거운 곳입니다',
      '부산의 진짜 매력을 느껴보세요',
      '현지인이 강력히 추천하는 장소입니다',
      '가보면 무조건 다시 생각날 거예요',
      '분위기 하나는 정말 기가 막힙니다',
    ];
    function pickDialect() {
      return DIALECT_PHRASES[Math.floor(Math.random() * DIALECT_PHRASES.length)];
    }

    // === Spot Data Cache ===
    const spotCache = {};

    // === TourAPI ===
    async function fetchSpots(contentTypeId, numOfRows = 20) {
      const cacheKey = `${contentTypeId}_${numOfRows}`;
      if (spotCache[cacheKey]) return spotCache[cacheKey];
      const params = new URLSearchParams({
        serviceKey: TOUR_API_KEY,
        numOfRows,
        pageNo: 1,
        MobileOS: 'ETC',
        MobileApp: '어데가노',
        _type: 'json',
        areaCode: 6,
        contentTypeId,
        arrange: 'Q'
      });
      const res = await fetch(`${BASE_URL}/areaBasedList2?${params}`);
      const data = await res.json();
      const items = data?.response?.body?.items?.item || [];
      spotCache[cacheKey] = items;
      return items;
    }

    async function fetchSpotDetail(contentId, contentTypeId) {
      const params = new URLSearchParams({
        serviceKey: TOUR_API_KEY,
        contentId,
        contentTypeId,
        MobileOS: 'ETC',
        MobileApp: '어데가노',
        _type: 'json',
        defaultYN: 'Y',
        overviewYN: 'Y',
        firstImageYN: 'Y',
        addrinfoYN: 'Y',
        mapinfoYN: 'Y'
      });
      const res = await fetch(`${BASE_URL}/detailCommon2?${params}`);
      const data = await res.json();
      const items = data?.response?.body?.items?.item;
      return items ? items[0] : null;
    }

    async function fetchTodayFestivals() {
      const params = new URLSearchParams({
        serviceKey: TOUR_API_KEY,
        numOfRows: 20,
        pageNo: 1,
        MobileOS: 'ETC',
        MobileApp: '어데가노',
        _type: 'json',
        areaCode: 6,
        eventStartDate: '20230101', // fetch wide range of festivals
        arrange: 'Q' // Arrange by image presence/quality
      });
      const res = await fetch(`${BASE_URL}/searchFestival2?${params}`);
      const data = await res.json();
      const items = data?.response?.body?.items?.item || [];
      return items;
    }

    async function fetchDetailIntro(contentId, contentTypeId) {
      const params = new URLSearchParams({
        serviceKey: TOUR_API_KEY, contentId, contentTypeId,
        MobileOS: 'ETC', MobileApp: '어데가노', _type: 'json',
      });
      const res = await fetch(`${BASE_URL}/detailIntro2?${params}`);
      const data = await res.json();
      const items = data?.response?.body?.items?.item;
      return items ? (Array.isArray(items) ? items[0] : items) : null;
    }

    async function fetchDetailInfo(contentId, contentTypeId) {
      const params = new URLSearchParams({
        serviceKey: TOUR_API_KEY, contentId, contentTypeId,
        MobileOS: 'ETC', MobileApp: '어데가노', _type: 'json',
      });
      const res = await fetch(`${BASE_URL}/detailInfo2?${params}`);
      const data = await res.json();
      const items = data?.response?.body?.items?.item || [];
      return Array.isArray(items) ? items : [items];
    }

    async function fetchDetailImages(contentId) {
      const params = new URLSearchParams({
        serviceKey: TOUR_API_KEY, contentId,
        MobileOS: 'ETC', MobileApp: '어데가노', _type: 'json',
        imageYN: 'Y', subImageYN: 'Y',
      });
      const res = await fetch(`${BASE_URL}/detailImage2?${params}`);
      const data = await res.json();
      const items = data?.response?.body?.items?.item || [];
      return Array.isArray(items) ? items : [items];
    }

    async function fetchNaverBlogReviews(query, display = 5) {
      try {
        await resolveNaverProxy();
        const params = new URLSearchParams({ query: query + ' 부산 후기', display, sort: 'sim' });
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 4500);
        const res = await fetch(`${NAVER_PROXY}/blog?${params}`, { signal: ctrl.signal });
        clearTimeout(timer);
        const data = await res.json();
        return data.items || [];
      } catch (e) { console.warn('Naver blog unavailable (proxy offline?):', e.message); return []; }
    }

    async function fetchNaverImages(query, display = 10) {
      try {
        await resolveNaverProxy();
        const params = new URLSearchParams({ query: query + ' 부산 여행', display, sort: 'sim' });
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 4500);
        const res = await fetch(`${NAVER_PROXY}/image?${params}`, { signal: ctrl.signal });
        clearTimeout(timer);
        const data = await res.json();
        return data.items || [];
      } catch (e) { console.warn('Naver image unavailable (proxy offline?):', e.message); return []; }
    }

    async function fetchKeywordSearch(keyword) {
      const params = new URLSearchParams({
        serviceKey: TOUR_API_KEY,
        numOfRows: 30,
        pageNo: 1,
        MobileOS: 'ETC',
        MobileApp: '어데가노',
        _type: 'json',
        areaCode: 6,
        keyword,
      });
      const res = await fetch(`${BASE_URL}/searchKeyword2?${params}`);
      const data = await res.json();
      const items = data?.response?.body?.items?.item || [];
      return Array.isArray(items) ? items : [items];
    }

    // === Cards ===
    function skeletonCards(n = 5) {
      return Array.from({ length: n }, () => `
        <div class="skeleton-card">
          <div class="skel-img"></div>
          <div class="skel-body">
            <div class="skel-line"></div>
            <div class="skel-line sm"></div>
          </div>
        </div>
      `).join('');
    }

    function renderCard(spot, idx, typeId) {
      const typeName = TYPE_NAMES[typeId] || '장소';
      const addr = spot.addr1 || '주소 정보 없음';
      const dialect = pickDialect();
      const img = spot.firstimage || spot.firstimage2 || '';
      const imgHtml = img
        ? `<img class="card-image" src="${img}" loading="lazy" onerror="this.style.display='none';this.parentElement.style.background='linear-gradient(135deg,#e3f2fd,#bbdefb)'" alt="${spot.title}">`
        : `<div style="width:100%;height:100%;background:linear-gradient(135deg,#e3f2fd,#bbdefb);display:flex;align-items:center;justify-content:center;font-size:40px">${TYPE_ICONS[typeId] || '🏝'}</div>`;
      return `
        <div class="travel-card" data-spot='${JSON.stringify({
          contentid: spot.contentid || '',
          contenttypeid: typeId,
          title: spot.title || '',
          addr1: spot.addr1 || '',
          firstimage: spot.firstimage || '',
          firstimage2: spot.firstimage2 || '',
          mapx: spot.mapx || '',
          mapy: spot.mapy || '',
          tel: spot.tel || ''
        }).replace(/'/g, '&apos;')}'>
          <div class="card-image-wrap">
            ${idx !== null ? `<div class="rank-badge">${idx + 1}</div>` : ''}
            <div class="type-badge">${typeName}</div>
            ${imgHtml}
          </div>
          <div class="card-body">
            <div class="card-title">${spot.title || '이름 없음'}</div>
            <div class="card-addr">${addr}</div>
            <div class="card-dialect">💬 ${dialect}</div>
          </div>
        </div>
      `;
    }

    function renderFestivalCard(fest, idx) {
      const addr = fest.addr1 || '위치 정보 없음';
      const dialect = pickDialect();
      const img = fest.firstimage || fest.firstimage2 || '';
      const imgHtml = img
        ? `<img class="card-image" src="${img}" loading="lazy" onerror="this.style.display='none';this.parentElement.style.background='linear-gradient(135deg,#fff3e0,#ffcc80)'" alt="${fest.title}">`
        : `<div style="width:100%;height:100%;background:linear-gradient(135deg,#fff3e0,#ffcc80);display:flex;align-items:center;justify-content:center;font-size:40px">🎪</div>`;
      const period = fest.eventstartdate && fest.eventenddate
        ? `${fest.eventstartdate.slice(4,6)}.${fest.eventstartdate.slice(6,8)} ~ ${fest.eventenddate.slice(4,6)}.${fest.eventenddate.slice(6,8)}`
        : '';
      return `
        <div class="travel-card" data-spot='${JSON.stringify({
          contentid: fest.contentid || '',
          contenttypeid: '15',
          title: fest.title || '',
          addr1: fest.addr1 || '',
          firstimage: fest.firstimage || '',
          firstimage2: fest.firstimage2 || '',
          mapx: fest.mapx || '',
          mapy: fest.mapy || '',
          tel: fest.tel || ''
        }).replace(/'/g, '&apos;')}'>
          <div class="card-image-wrap">
            ${idx !== null ? `<div class="rank-badge">${idx + 1}</div>` : ''}
            <div class="type-badge">진행중</div>
            ${imgHtml}
          </div>
          <div class="card-body">
            <div class="card-title">${fest.title || '축제'}</div>
            <div class="card-addr">${period} · ${addr}</div>
            <div class="card-dialect">💬 ${dialect}</div>
          </div>
        </div>
      `;
    }

    // === Ranking Section ===
    let currentMood = 'all';
    let currentTypeTab = 'home';
    async function loadRanking() {
      const container = document.getElementById('ranking-carousel');
      container.innerHTML = skeletonCards(6);
      try {
        const typeId = (currentTypeTab !== 'home' && /^\d+$/.test(currentTypeTab)) ? currentTypeTab : '12';
        let spots = await fetchSpots(typeId, 20);
        // Mood filter by title keywords
        if (currentMood !== 'all') {
          const keywords = {
            '바다': /해변|바다|해운대|광안|다대포|송정|해수욕/,
            '야경': /야경|타워|대교|광안|전망/,
            '뉴트로': /감천|문화마을|골목|해리|카페거리/,
            '맛집': /시장|전통|맛집|거리/,
            '감성': /공원|전망|포토|문화|카페/,
            '가족': /공원|놀이|박물관|아쿠아|테마/,
            '커플': /전망|공원|데이트|해변|야경/,
            '혼자': /카페|박물관|공원|골목|문화/,
          };
          const re = keywords[currentMood];
          if (re) {
            const filtered = spots.filter(s => re.test(s.title || ''));
            if (filtered.length >= 3) spots = filtered;
          }
        }
        spots = spots.filter(s => parseFloat(s.mapx) && parseFloat(s.mapy)).slice(0, 12);
        if (!spots.length) {
          container.innerHTML = '<div class="empty-card">추천할 장소를 찾지 못했어요. 다른 테마를 선택해보세요.</div>';
          return;
        }
        container.innerHTML = spots.map((s, i) => renderCard(s, i, typeId)).join('');
        bindCardClicks();
      } catch (e) {
        console.error(e);
        container.innerHTML = '<div class="empty-card">⚠️ 데이터 불러오기 실패</div>';
      }
    }

    // === Accommodation Data (Phase 2 확장) ===
    const accommodationData = [
      { id: "ACC-001", name: "부산 더 플레이스", location: "해운대구", image: "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=300&h=200&fit=crop", price: 150000, rating: 4.5, reviewCount: 328, tags: ["바다뷰", "조용함"],
        category: "호텔", grade: "4성급", amenities: ["WiFi", "주차장", "수영장", "조식", "피트니스"], images: ["https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1590490360182-c33d5f4c9f55?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?w=600&h=400&fit=crop"], checkInTime: "15:00", checkOutTime: "11:00", description: "해운대 해변에서 도보 5분 거리에 위치한 모던 부티크 호텔입니다. 전 객실 오션뷰를 자랑하며, 루프탑 수영장과 조식 뷔페를 제공합니다." },
      { id: "ACC-002", name: "센텀 스테이", location: "수영구", image: "https://images.unsplash.com/photo-1611075326935-859a7195c0b9?w=300&h=200&fit=crop", price: 120000, rating: 4.3, reviewCount: 245, tags: ["현대식", "야경"],
        category: "호텔", grade: "3성급", amenities: ["WiFi", "주차장", "조식"], images: ["https://images.unsplash.com/photo-1611075326935-859a7195c0b9?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1566665797739-1674de7a421a?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1564078516393-cf04bd966897?w=600&h=400&fit=crop"], checkInTime: "15:00", checkOutTime: "11:00", description: "센텀시티 중심부에 위치하여 신세계백화점, 벡스코까지 도보 이동이 가능합니다. 현대적인 인테리어와 야경 뷰가 인기입니다." },
      { id: "ACC-003", name: "감천 게스트하우스", location: "사상구", image: "https://images.unsplash.com/photo-1628930460529-1def7ed70753?w=300&h=200&fit=crop", price: 80000, rating: 4.7, reviewCount: 412, tags: ["감성", "저가"],
        category: "게스트하우스", grade: "", amenities: ["WiFi", "공용주방", "세탁기"], images: ["https://images.unsplash.com/photo-1628930460529-1def7ed70753?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1555854877-bab0e564b8d5?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?w=600&h=400&fit=crop"], checkInTime: "14:00", checkOutTime: "11:00", description: "감천문화마을 인근의 감성 가득한 게스트하우스입니다. 여행자들과 교류할 수 있는 공용 라운지와 옥상 테라스가 있습니다." },
      { id: "ACC-004", name: "해운대 비치 리조트", location: "해운대구", image: "https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=300&h=200&fit=crop", price: 200000, rating: 4.8, reviewCount: 567, tags: ["럭셔리", "해변"],
        category: "호텔", grade: "5성급", amenities: ["WiFi", "주차장", "수영장", "조식", "스파", "피트니스", "바"], images: ["https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1571896349842-33c89424de2d?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1584132967334-10e028bd69f7?w=600&h=400&fit=crop"], checkInTime: "15:00", checkOutTime: "12:00", description: "해운대 비치 프론트에 위치한 프리미엄 리조트입니다. 인피니티 풀, 프라이빗 비치, 미슐랭 셰프의 레스토랑 등 최상의 시설을 갖추고 있습니다." },
      { id: "ACC-005", name: "부산역 호텔", location: "동구", image: "https://images.unsplash.com/photo-1566195992011-5527897915a2?w=300&h=200&fit=crop", price: 100000, rating: 4.2, reviewCount: 156, tags: ["교통", "편리"],
        category: "호텔", grade: "3성급", amenities: ["WiFi", "주차장"], images: ["https://images.unsplash.com/photo-1566195992011-5527897915a2?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1618773928121-c32242e63f39?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1595576508898-0ad5c879a061?w=600&h=400&fit=crop"], checkInTime: "14:00", checkOutTime: "11:00", description: "부산역 바로 앞에 위치하여 KTX 이용객에게 최적입니다. 깔끔한 비즈니스 호텔로 합리적인 가격이 강점입니다." },
      { id: "ACC-006", name: "광안리 펜션", location: "수영구", image: "https://images.unsplash.com/photo-1605276374104-dee2a0db896d?w=300&h=200&fit=crop", price: 110000, rating: 4.4, reviewCount: 298, tags: ["커플", "야경"],
        category: "펜션", grade: "", amenities: ["WiFi", "주차장", "바베큐", "넷플릭스"], images: ["https://images.unsplash.com/photo-1605276374104-dee2a0db896d?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1602002418816-5c0aeef426aa?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=600&h=400&fit=crop"], checkInTime: "15:00", checkOutTime: "11:00", description: "광안리 해변이 한눈에 보이는 프라이빗 펜션입니다. 야경을 즐기며 바베큐 파티를 할 수 있어 커플과 소모임에 인기입니다." },
      { id: "ACC-007", name: "서면 비즈니스 호텔", location: "부산진구", image: "https://images.unsplash.com/photo-1612152087212-1469a138df93?w=300&h=200&fit=crop", price: 95000, rating: 4.1, reviewCount: 178, tags: ["비즈니스"],
        category: "호텔", grade: "3성급", amenities: ["WiFi", "주차장", "조식", "비즈니스센터"], images: ["https://images.unsplash.com/photo-1612152087212-1469a138df93?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1590490360182-c33d5f4c9f55?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1578683010236-d716f9a3f461?w=600&h=400&fit=crop"], checkInTime: "14:00", checkOutTime: "12:00", description: "서면 중심가에 위치한 비즈니스 호텔입니다. 지하철역 도보 3분, 서면 먹자골목 인접으로 출장과 관광 모두 편리합니다." },
      { id: "ACC-008", name: "다대포 글램핑", location: "사하구", image: "https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=300&h=200&fit=crop", price: 130000, rating: 4.6, reviewCount: 389, tags: ["글램핑", "독특함"],
        category: "펜션", grade: "", amenities: ["WiFi", "주차장", "바베큐", "캠프파이어"], images: ["https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1510312305653-8ed496efae75?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=600&h=400&fit=crop"], checkInTime: "15:00", checkOutTime: "11:00", description: "다대포 해수욕장 인근에 위치한 글램핑장입니다. 바다 소리를 들으며 캠핑을 즐길 수 있고, 일몰 명소로도 유명합니다." },
      { id: "ACC-009", name: "영도 아트 호텔", location: "영도구", image: "https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?w=300&h=200&fit=crop", price: 140000, rating: 4.5, reviewCount: 267, tags: ["예술", "힙"],
        category: "호텔", grade: "4성급", amenities: ["WiFi", "주차장", "갤러리", "카페"], images: ["https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?w=600&h=400&fit=crop"], checkInTime: "15:00", checkOutTime: "11:00", description: "영도 깡깡이 예술마을 근처에 위치한 아트 컨셉 호텔입니다. 로비와 객실에 지역 작가의 작품이 전시되어 있으며, 1층 카페에서 바다 뷰를 즐길 수 있습니다." },
      { id: "ACC-010", name: "기장 힐링 리조트", location: "기장군", image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?w=300&h=200&fit=crop", price: 160000, rating: 4.7, reviewCount: 445, tags: ["힐링", "자연"],
        category: "펜션", grade: "", amenities: ["WiFi", "주차장", "수영장", "조식", "정원"], images: ["https://images.unsplash.com/photo-1566073771259-6a8506099945?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?w=600&h=400&fit=crop","https://images.unsplash.com/photo-1584132967334-10e028bd69f7?w=600&h=400&fit=crop"], checkInTime: "15:00", checkOutTime: "11:00", description: "기장 바닷가에 자리한 힐링 리조트입니다. 넓은 정원과 야외 수영장을 갖추고 있으며, 기장 시장의 신선한 해산물을 조식으로 즐길 수 있습니다." }
    ];

    async function loadAccommodationSection() {
      const container = document.getElementById('accommodation-carousel');
      container.innerHTML = skeletonCards(5);
      try {
        const stays = (await fetchSpots('32', 24))
          .filter(s => parseFloat(s.mapx) && parseFloat(s.mapy))
          .filter(s => s.title)
          .slice(0, 12);

        if (!stays.length) {
          container.innerHTML = '<div class="empty-card">숙박 데이터를 찾지 못했어요. 잠시 후 다시 시도해주세요.</div>';
          return;
        }

        container.innerHTML = stays.map((s, i) => renderCard(s, i, '32')).join('');
        bindCardClicks();
      } catch (e) {
        console.error('Accommodation error:', e);
        container.innerHTML = '<div class="empty-card">숙소 정보를 불러올 수 없습니다.</div>';
      }
    }

    // === Accommodation Search & Detail (Phase 2) ===
    const amenityIcons = {
      'WiFi': '📶', '주차장': '🅿️', '수영장': '🏊', '조식': '🍳',
      '피트니스': '🏋️', '스파': '💆', '바': '🍸', '공용주방': '🍴',
      '세탁기': '🧺', '바베큐': '🔥', '넷플릭스': '📺', '캠프파이어': '🔥',
      '갤러리': '🎨', '카페': '☕', '정원': '🌿', '비즈니스센터': '💼'
    };

    function openAccommodationSearch(keyword) {
      const page = document.getElementById('accommodation-page');
      const input = document.getElementById('acc-search-input');
      if (keyword) input.value = keyword;
      renderAccSearchGrid(input.value);
      page.classList.add('open');
      history.pushState({ overlay: 'acc-search' }, '', `#/accommodation${keyword ? '?keyword=' + encodeURIComponent(keyword) : ''}`);
    }

    function closeAccommodationSearch() {
      document.getElementById('accommodation-page').classList.remove('open');
    }

    function renderAccSearchGrid(keyword) {
      const grid = document.getElementById('acc-search-grid');
      const activeFilters = Array.from(document.querySelectorAll('#acc-filter-chips .filter-chip.active')).map(c => c.dataset.filter);
      let filtered = accommodationData.filter(acc => {
        if (keyword) {
          const q = keyword.toLowerCase();
          if (!acc.name.toLowerCase().includes(q) && !acc.location.toLowerCase().includes(q) && !acc.tags.some(t => t.includes(q))) return false;
        }
        for (const f of activeFilters) {
          if (f === 'breakfast' && !acc.amenities.includes('조식')) return false;
          if (f === 'hotel' && acc.category !== '호텔') return false;
          if (f === 'pension' && acc.category !== '펜션') return false;
          if (f === 'guesthouse' && acc.category !== '게스트하우스') return false;
        }
        return true;
      });
      grid.innerHTML = filtered.length ? filtered.map(acc => `
        <div class="acc-grid-card" onclick="openAccommodationDetail('${acc.id}')">
          <img class="acc-card-img" src="${acc.image}" alt="${acc.name}" loading="lazy" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22200%22%3E%3Crect fill=%22%23e9ecef%22 width=%22300%22 height=%22200%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 text-anchor=%22middle%22 dy=%22.3em%22 font-size=%2214%22 fill=%22%23999%22%3E이미지%3C/text%3E%3C/svg%3E'">
          <div class="acc-card-body">
            <div class="acc-card-cat">${acc.category}${acc.grade ? ' · ' + acc.grade : ''}</div>
            <div class="acc-card-name">${acc.name}</div>
            <div class="acc-card-loc">📍 ${acc.location}</div>
            <div class="acc-card-rating">
              <span class="stars">${'★'.repeat(Math.round(acc.rating))}</span>
              <span style="font-weight:700;color:var(--dark)">${acc.rating}</span>
              <span class="review-cnt">(${acc.reviewCount})</span>
            </div>
            <div class="acc-card-price">₩${acc.price.toLocaleString()}<small> /박~</small></div>
          </div>
        </div>
      `).join('') : '<div class="empty-card" style="grid-column:1/-1">검색 결과가 없습니다.</div>';
    }

    function openAccommodationDetail(accId) {
      const acc = accommodationData.find(a => a.id === accId);
      if (!acc) return;
      const page = document.getElementById('accommodation-detail');
      // Header title
      document.getElementById('acc-detail-header-title').textContent = acc.name;
      // Gallery
      const mainImg = document.getElementById('acc-detail-main-img');
      const imgs = acc.images && acc.images.length ? acc.images : [acc.image];
      mainImg.src = imgs[0];
      mainImg.alt = acc.name;
      document.getElementById('acc-gallery-counter').textContent = `1 / ${imgs.length}`;
      // Thumbnails
      const thumbsEl = document.getElementById('acc-detail-thumbs');
      thumbsEl.innerHTML = imgs.map((url, i) => `<img src="${url}" alt="${acc.name} ${i+1}" class="${i === 0 ? 'active' : ''}" data-idx="${i}" />`).join('');
      thumbsEl.querySelectorAll('img').forEach(thumb => {
        thumb.addEventListener('click', () => {
          mainImg.src = thumb.src;
          thumbsEl.querySelectorAll('img').forEach(t => t.classList.remove('active'));
          thumb.classList.add('active');
          document.getElementById('acc-gallery-counter').textContent = `${parseInt(thumb.dataset.idx)+1} / ${imgs.length}`;
        });
      });
      // Info
      document.getElementById('acc-detail-info').innerHTML = `
        <div class="acc-detail-cat-grade">${acc.category}${acc.grade ? ' · ' + acc.grade : ''}</div>
        <div class="acc-detail-name">${acc.name}</div>
        <div class="acc-detail-rating">
          <span class="stars">${'★'.repeat(Math.round(acc.rating))}</span>
          <span class="score">${acc.rating}</span>
          <span class="cnt">(리뷰 ${acc.reviewCount}개)</span>
        </div>
        <div class="acc-detail-location">📍 부산광역시 ${acc.location}</div>
      `;
      // Check-in/out
      document.getElementById('acc-detail-checkin-out').innerHTML = `
        <div class="acc-checkin-block">
          <div class="label">체크인</div>
          <div class="time">${acc.checkInTime || '15:00'}</div>
        </div>
        <div class="acc-checkout-block">
          <div class="label">체크아웃</div>
          <div class="time">${acc.checkOutTime || '11:00'}</div>
        </div>
      `;
      // Amenities
      const amenities = acc.amenities || [];
      document.getElementById('acc-detail-amenities').innerHTML = `
        <h3>편의시설</h3>
        <div class="amenity-list">
          ${amenities.map(a => `<div class="amenity-item"><span class="amenity-icon">${amenityIcons[a] || '✅'}</span>${a}</div>`).join('')}
        </div>
      `;
      // Description
      document.getElementById('acc-detail-desc').innerHTML = `
        <h3>숙소 소개</h3>
        <p>${acc.description || ''}</p>
      `;
      // Booking bar
      document.getElementById('acc-booking-bar').innerHTML = `
        <div class="booking-price">₩${acc.price.toLocaleString()}<small> /박</small></div>
        <button class="booking-btn" onclick="alert('예약 기능은 준비 중입니다.')">₩${acc.price.toLocaleString()} 예약하기</button>
      `;
      page.classList.add('open');
      page.scrollTop = 0;
      const today = new Date();
      const tomorrow = new Date(today); tomorrow.setDate(today.getDate() + 1);
      const fmt = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
      history.pushState({ overlay: 'acc-detail' }, '', `#/stay/${accId}?checkInDate=${fmt(today)}&checkOutDate=${fmt(tomorrow)}&rooms[0][adult]=2`);
    }

    function closeAccommodationDetail() {
      document.getElementById('accommodation-detail').classList.remove('open');
    }

    // Wire up accommodation search page events
    document.getElementById('acc-search-back').addEventListener('click', () => {
      history.back();
    });
    document.getElementById('acc-detail-back').addEventListener('click', () => {
      history.back();
    });
    document.getElementById('acc-search-btn').addEventListener('click', () => {
      renderAccSearchGrid(document.getElementById('acc-search-input').value);
    });
    document.getElementById('acc-search-input').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') renderAccSearchGrid(e.target.value);
    });
    document.querySelectorAll('#acc-filter-chips .filter-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        chip.classList.toggle('active');
        renderAccSearchGrid(document.getElementById('acc-search-input').value);
      });
    });

    async function loadBeachSection() {
      const container = document.getElementById('beach-carousel');
      container.innerHTML = skeletonCards(5);
      try {
        const all = await fetchSpots('12', 30);
        let beach = all.filter(s =>
          /해변|바다|해수욕|해운대|광안|다대포|송정|이기대|태종대|송도/.test(s.title || '')
          && parseFloat(s.mapx) && parseFloat(s.mapy)
        );
        if (beach.length < 5) beach = all.filter(s => parseFloat(s.mapx) && parseFloat(s.mapy)).slice(0, 10);
        beach = beach.slice(0, 12);
        container.innerHTML = beach.map((s, i) => renderCard(s, i, '12')).join('') || '<div class="empty-card">바다 관광지 정보가 없습니다.</div>';
        bindCardClicks();
      } catch (e) { console.error(e); container.innerHTML = '<div class="empty-card">⚠️ 불러오기 실패</div>'; }
    }

    async function loadFoodSection() {
      const container = document.getElementById('food-carousel');
      container.innerHTML = skeletonCards(5);
      try {
        const foods = await fetchSpots('39', 20);
        const valid = foods.filter(s => parseFloat(s.mapx) && parseFloat(s.mapy)).slice(0, 12);
        container.innerHTML = valid.map((s, i) => renderCard(s, i, '39')).join('') || '<div class="empty-card">맛집 정보가 없습니다.</div>';
        bindCardClicks();
      } catch (e) { console.error(e); container.innerHTML = '<div class="empty-card">⚠️ 불러오기 실패</div>'; }
    }

    async function loadFestivalSection() {
      const container = document.getElementById('festival-carousel');
      container.innerHTML = skeletonCards(5);
      try {
        const fests = await fetchTodayFestivals();
        const valid = fests.filter(f => parseFloat(f.mapx) && parseFloat(f.mapy)).slice(0, 12);
        if (!valid.length) {
          container.innerHTML = '<div class="empty-card">현재 가져올 수 있는 축제 정보가 없습니다.</div>';
          return;
        }
        container.innerHTML = valid.map((f, i) => renderFestivalCard(f, i)).join('');
        bindCardClicks();
      } catch (e) { console.error(e); container.innerHTML = '<div class="empty-card">⚠️ 불러오기 실패</div>'; }
    }

    // ============================================
    // === CARD CLICK → DETAIL PAGE ===
    // ============================================
    function bindCardClicks() {
      document.querySelectorAll('.travel-card[data-spot]').forEach(card => {
        if (card._bound) return;
        card._bound = true;
        card.addEventListener('click', () => {
          try {
            const spotData = JSON.parse(card.dataset.spot);
            openDetailPage(spotData);
          } catch (e) {
            console.error('Card click error:', e);
          }
        });
      });
    }

    let detailMap = null;
    let detailMarkerLayer = null;

    // === Intro field definitions per content type ===
    const INTRO_FIELDS = {
      '12': [ // 관광지
        { key: 'usetime', icon: '🕐', label: '이용시간' },
        { key: 'restdate', icon: '📅', label: '쉬는날' },
        { key: 'infocenter', icon: '📞', label: '문의처' },
        { key: 'parking', icon: '🅿️', label: '주차' },
        { key: 'chkbabycarriage', icon: '👶', label: '유모차' },
        { key: 'chkpet', icon: '🐕', label: '반려동물' },
        { key: 'opendate', icon: '📆', label: '개장일' },
        { key: 'expguide', icon: '🎤', label: '체험안내' },
      ],
      '39': [ // 음식점
        { key: 'opentimefood', icon: '🕐', label: '영업시간' },
        { key: 'firstmenu', icon: '⭐', label: '대표메뉴' },
        { key: 'treatmenu', icon: '🍽', label: '취급메뉴' },
        { key: 'restdatefood', icon: '📅', label: '쉬는날' },
        { key: 'packing', icon: '📦', label: '포장' },
        { key: 'parkingfood', icon: '🅿️', label: '주차' },
        { key: 'infocenterfood', icon: '📞', label: '문의' },
        { key: 'seat', icon: '💺', label: '좌석수' },
        { key: 'kidsfacility', icon: '👶', label: '키즈시설' },
        { key: 'smoking', icon: '🚭', label: '금연/흡연' },
      ],
      '14': [ // 문화시설
        { key: 'usetime', icon: '🕐', label: '이용시간' },
        { key: 'usefee', icon: '💰', label: '이용요금' },
        { key: 'restdateculture', icon: '📅', label: '쉬는날' },
        { key: 'parkingculture', icon: '🅿️', label: '주차' },
        { key: 'infocenterculture', icon: '📞', label: '문의처' },
        { key: 'scale', icon: '📐', label: '규모' },
        { key: 'spendtime', icon: '⏱', label: '소요시간' },
        { key: 'chkbabycarriageculture', icon: '👶', label: '유모차' },
        { key: 'chkpetculture', icon: '🐕', label: '반려동물' },
      ],
      '15': [ // 축제/행사
        { key: 'eventstartdate', icon: '📆', label: '시작일', format: 'date' },
        { key: 'eventenddate', icon: '📆', label: '종료일', format: 'date' },
        { key: 'playtime', icon: '🕐', label: '공연시간' },
        { key: 'eventplace', icon: '📍', label: '행사장소' },
        { key: 'usetimefestival', icon: '⏱', label: '이용시간' },
        { key: 'program', icon: '📋', label: '프로그램' },
        { key: 'spendtimefestival', icon: '⏱', label: '소요시간' },
        { key: 'agelimit', icon: '🔞', label: '이용제한' },
        { key: 'sponsor1', icon: '🏢', label: '주최' },
        { key: 'sponsor1tel', icon: '📞', label: '문의' },
        { key: 'subevent', icon: '🎯', label: '부대행사' },
        { key: 'bookingplace', icon: '🎟', label: '예매' },
      ],
      '32': [ // 숙박
        { key: 'checkintime', icon: '🔑', label: '체크인' },
        { key: 'checkouttime', icon: '🚪', label: '체크아웃' },
        { key: 'parkinglodging', icon: '🅿️', label: '주차' },
        { key: 'infocenterlodging', icon: '📞', label: '문의' },
        { key: 'subfacility', icon: '🏊', label: '부대시설' },
        { key: 'foodplace', icon: '🍽', label: '식음료장' },
        { key: 'pickup', icon: '🚗', label: '픽업서비스' },
        { key: 'barbecue', icon: '🔥', label: '바베큐' },
        { key: 'refundregulation', icon: '💳', label: '환불규정' },
      ],
    };

    function formatIntroDate(val) {
      if (!val || val.length !== 8) return val;
      return `${val.slice(0,4)}.${val.slice(4,6)}.${val.slice(6,8)}`;
    }

    function stripHtml(html) {
      const tmp = document.createElement('div');
      tmp.innerHTML = html || '';
      return tmp.textContent || tmp.innerText || '';
    }

    function renderIntroSection(intro, typeId) {
      const fields = INTRO_FIELDS[typeId] || [];
      const rows = fields
        .filter(f => intro[f.key] && String(intro[f.key]).trim())
        .map(f => {
          let val = String(intro[f.key]).trim();
          if (f.format === 'date') val = formatIntroDate(val);
          return `<div class="detail-intro-row">
            <span class="detail-intro-icon">${f.icon}</span>
            <div class="detail-intro-text">
              <span class="detail-intro-label">${f.label}</span>
              <span class="detail-intro-value">${val}</span>
            </div>
          </div>`;
        });
      if (!rows.length) return '';
      const sectionTitle = typeId === '39' ? '🍜 음식점 정보' :
                           typeId === '32' ? '🏨 숙박 정보' :
                           typeId === '15' ? '🎪 행사 정보' :
                           typeId === '14' ? '🏛 시설 정보' : '📋 이용 안내';
      return `<div class="detail-intro-section">
        <h3>${sectionTitle}</h3>
        <div class="detail-intro-grid">${rows.join('')}</div>
      </div>`;
    }

    function renderDetailGallery(images) {
      if (!images.length) return '';
      return `<div class="detail-gallery">
        <h3>📸 사진</h3>
        <div class="detail-gallery-scroll">
          ${images.map(img => `<img src="${img.originimgurl || img.smallimageurl}" alt="" loading="lazy" />`).join('')}
        </div>
      </div>`;
    }

    function renderMenuSection(items) {
      const menuItems = items.filter(i => i.infoname);
      if (!menuItems.length) return '';
      return `<div class="detail-menu-section">
        <h3>🍽 메뉴</h3>
        <div class="detail-menu-list">
          ${menuItems.map(m => `<div class="detail-menu-item">
            <div class="detail-menu-info">
              <div class="detail-menu-name">${m.infoname}</div>
              ${m.infotext ? `<div class="detail-menu-desc">${m.infotext}</div>` : ''}
            </div>
          </div>`).join('')}
        </div>
      </div>`;
    }

    function renderRoomSection(items) {
      const rooms = items.filter(i => i.roomtitle);
      if (!rooms.length) return '';
      return `<div class="detail-room-section">
        <h3>🛏 객실 정보</h3>
        <div class="detail-room-grid">
          ${rooms.map(r => {
            const price = r.roomoffseasonminfee1 || r.roompeakseasonminfee1 || '';
            const priceText = price ? `${Number(price).toLocaleString()}원~` : '가격 문의';
            const size = r.roomsize1 ? `${r.roomsize1}㎡` : '';
            const count = r.roomcount ? `${r.roomcount}실` : '';
            const cap = r.roommaxcount ? `최대 ${r.roommaxcount}인` : '';
            const meta = [size, count, cap].filter(Boolean).join(' · ');
            const img = r.roomimg1 || '';
            return `<div class="detail-room-card">
              ${img ? `<img src="${img}" alt="${r.roomtitle}" />` : ''}
              <div class="detail-room-info">
                <div class="detail-room-name">${r.roomtitle}</div>
                ${meta ? `<div class="detail-room-meta">${meta}</div>` : ''}
                <div class="detail-room-price">${priceText}</div>
                ${r.roomintro ? `<div style="font-size:12px;color:var(--muted);margin-top:4px">${r.roomintro}</div>` : ''}
              </div>
            </div>`;
          }).join('')}
        </div>
      </div>`;
    }

    function renderBlogReviews(blogs) {
      if (!blogs.length) return '';
      const reviewsHtml = blogs.slice(0, 5).map((b, i) => {
        const title = (b.title || '').replace(/<\/?b>/g, '');
        const desc = (b.description || '').replace(/<\/?b>/g, '');
        const date = b.postdate ? `${b.postdate.slice(0,4)}.${b.postdate.slice(4,6)}.${b.postdate.slice(6,8)}` : '';
        return `<a href="${b.link}" target="_blank" rel="noopener" class="review-card-link" style="text-decoration:none;color:inherit">
          <div style="padding:16px 20px;border-bottom:1px solid var(--border);transition:background 0.15s;cursor:pointer"
               onmouseover="this.style.background='var(--bg-alt)'" onmouseout="this.style.background='transparent'">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
              <div style="font-size:15px;font-weight:700;color:var(--dark);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;margin-right:12px">${title}</div>
              <span style="font-size:11px;color:var(--light-muted);white-space:nowrap">${date}</span>
            </div>
            <div style="font-size:13px;color:var(--text);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">${desc}</div>
            <div style="margin-top:8px;font-size:12px;color:var(--muted);display:flex;align-items:center;gap:4px">
              <span>✍️</span><span>${b.bloggername || '블로거'}</span>
              <span style="margin-left:8px;color:var(--primary);font-weight:600">블로그 후기 →</span>
            </div>
          </div>
        </a>`;
      }).join('');

      const moreBtn = blogs.length > 5 ? `<div style="padding:12px;text-align:center">
        <button onclick="this.parentElement.previousElementSibling.style.maxHeight='none';this.style.display='none'"
                style="font-size:13px;color:var(--primary);font-weight:700;background:none;border:none;cursor:pointer">
          후기 더보기 (${blogs.length}개) ▼
        </button></div>` : '';

      return `<div style="margin-bottom:28px">
        <h3 style="font-size:18px;font-weight:800;color:var(--dark);margin-bottom:12px">📝 방문자 후기</h3>
        <div style="background:var(--white);border-radius:var(--radius-card);box-shadow:var(--shadow-sm);overflow:hidden">
          <div style="max-height:none">${reviewsHtml}</div>
          ${moreBtn}
        </div>
      </div>`;
    }

    function renderVisitorPhotos(images) {
      if (!images.length) return '';
      const photosHtml = images.map(img => {
        const thumb = img.thumbnail || img.link;
        const full = img.link;
        return `<img src="${thumb}" alt="${(img.title||'').replace(/<\/?b>/g,'')}" loading="lazy"
                     onclick="window.open('${full}','_blank')"
                     style="width:140px;height:140px;object-fit:cover;border-radius:10px;flex-shrink:0;cursor:pointer;transition:transform 0.2s"
                     onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'"
                     onerror="this.style.display='none'" />`;
      }).join('');

      return `<div style="margin-bottom:28px">
        <h3 style="font-size:18px;font-weight:800;color:var(--dark);margin-bottom:12px">📸 방문자 사진</h3>
        <div style="display:flex;gap:10px;overflow-x:auto;padding-bottom:8px;-ms-overflow-style:none;scrollbar-width:none">
          ${photosHtml}
        </div>
      </div>`;
    }

    async function openDetailPage(spot) {
      const overlay = document.getElementById('detail-overlay');
      const img = spot.firstimage || spot.firstimage2 || '';
      const typeId = String(spot.contenttypeid || '12');
      const typeName = TYPE_NAMES[typeId] || '장소';
      const typeColor = TYPE_COLORS[typeId] || '#2b96ed';
      const typeIcon = TYPE_ICONS[typeId] || '🏝';

      // Clear dynamic sections
      document.getElementById('detail-gallery-container').innerHTML = '';
      document.getElementById('detail-overview-container').innerHTML = '';
      document.getElementById('detail-intro-container').innerHTML = '';
      document.getElementById('detail-extra-container').innerHTML = '';
      document.getElementById('detail-reviews-container').innerHTML = '';
      document.getElementById('detail-visitor-photos-container').innerHTML = '';

      // Reset tabs
      document.querySelectorAll('.detail-tab').forEach((t, i) => t.classList.toggle('active', i === 0));
      const gcEl = document.getElementById('detail-gallery-counter');
      if (gcEl) gcEl.style.display = 'none';

      // Push history state for browser back button support
      history.pushState({ overlay: 'detail' }, '', '#detail');

      // Set hero image
      const heroImg = document.getElementById('detail-hero-img');
      if (img) {
        heroImg.src = img;
        heroImg.alt = spot.title;
        heroImg.style.display = 'block';
      } else {
        heroImg.src = '';
        heroImg.style.display = 'none';
        document.getElementById('detail-hero').style.background =
          `linear-gradient(135deg, ${typeColor}33, ${typeColor}66)`;
      }

      // Badge
      const badge = document.getElementById('detail-badge');
      badge.textContent = `${typeIcon} ${typeName}`;
      badge.style.background = typeColor;

      // Title & subtitle
      document.getElementById('detail-title').textContent = spot.title || '장소 이름';
      document.getElementById('detail-subtitle').textContent = spot.addr1 || '부산광역시';
      document.getElementById('detail-header-title').textContent = spot.title || '장소 이름';

      // Dialect
      document.getElementById('detail-dialect').textContent = `"${pickDialect()}"`;

      // Info cards
      const infoCardsEl = document.getElementById('detail-info-cards');
      infoCardsEl.innerHTML = `
        <div class="detail-info-card">
          <div class="dic-icon">${typeIcon}</div>
          <div class="dic-label">분류</div>
          <div class="dic-value">${typeName}</div>
        </div>
        <div class="detail-info-card">
          <div class="dic-icon">📞</div>
          <div class="dic-label">전화</div>
          <div class="dic-value">${spot.tel || '정보 없음'}</div>
        </div>
        <div class="detail-info-card">
          <div class="dic-icon">📍</div>
          <div class="dic-label">위치</div>
          <div class="dic-value" style="font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${spot.addr1 || '주소 없음'}</div>
        </div>
      `;

      // Address
      document.getElementById('detail-addr').textContent = spot.addr1 || '주소 정보 없음';

      // Open overlay with animation
      overlay.classList.add('open');
      overlay.scrollTop = 0;
      document.body.style.overflow = 'hidden';

      // Map
      const lat = parseFloat(spot.mapy);
      const lng = parseFloat(spot.mapx);
      setTimeout(() => {
        const mapContainer = document.getElementById('detail-map');
        if (detailMap) {
          detailMap.remove();
          detailMap = null;
        }
        if (lat && lng) {
          detailMap = L.map(mapContainer).setView([lat, lng], 15);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap', maxZoom: 19
          }).addTo(detailMap);
          detailMarkerLayer = L.layerGroup().addTo(detailMap);
          L.marker([lat, lng], {
            icon: createPin(typeIcon, typeColor)
          }).addTo(detailMarkerLayer)
            .bindPopup(`<strong>${spot.title}</strong><br><small>${spot.addr1 || ''}</small>`)
            .openPopup();
        }
      }, 100);

      // Fetch all detail APIs in parallel
      if (spot.contentid) {
        try {
          const [detail, intro, infoItems, images] = await Promise.all([
            fetchSpotDetail(spot.contentid, typeId).catch(() => null),
            fetchDetailIntro(spot.contentid, typeId).catch(() => null),
            fetchDetailInfo(spot.contentid, typeId).catch(() => []),
            fetchDetailImages(spot.contentid).catch(() => []),
          ]);

          // Gallery + hero high-res upgrade
          if (images.length) {
            document.getElementById('detail-gallery-container').innerHTML = renderDetailGallery(images);
            // Upgrade hero image to originimgurl (higher quality)
            const heroImg = document.getElementById('detail-hero-img');
            const highRes = images[0].originimgurl || images[0].smallimageurl;
            if (highRes && heroImg) heroImg.src = highRes;
            // Show gallery counter
            const counter = document.getElementById('detail-gallery-counter');
            if (counter) {
              counter.textContent = `1 / ${images.length + 1}`;
              counter.style.display = 'block';
            }
          }

          // Overview
          if (detail?.overview) {
            document.getElementById('detail-overview-container').innerHTML = `
              <div class="detail-section-card">
                <h3>📝 소개</h3>
                <div style="font-size:15px;line-height:1.8;color:var(--text)">${detail.overview}</div>
              </div>`;
          }

          // Update tel
          if (detail?.tel) {
            const telCard = infoCardsEl.children[1];
            if (telCard) telCard.querySelector('.dic-value').textContent = detail.tel;
          }

          // Intro section (category-specific info)
          if (intro) {
            document.getElementById('detail-intro-container').innerHTML = renderIntroSection(intro, typeId);
          }

          // Extra: menus for restaurants, rooms for lodging
          if (typeId === '39' && infoItems.length) {
            document.getElementById('detail-extra-container').innerHTML = renderMenuSection(infoItems);
          } else if (typeId === '32' && infoItems.length) {
            document.getElementById('detail-extra-container').innerHTML = renderRoomSection(infoItems);
          }

        } catch (e) { console.error('Detail fetch error:', e); }
      }

      // Load nearby spots
      loadNearbySpots(spot, typeId);

      // Fetch Naver blog reviews + visitor photos (non-blocking)
      const spotName = spot.title || '';
      if (spotName) {
        Promise.all([
          fetchNaverBlogReviews(spotName),
          fetchNaverImages(spotName),
        ]).then(([blogs, photos]) => {
          if (blogs.length) {
            document.getElementById('detail-reviews-container').innerHTML = renderBlogReviews(blogs);
          } else {
            document.getElementById('detail-reviews-container').innerHTML =
              '<div class="detail-section-card" style="text-align:center;color:var(--muted);padding:32px"><p>📝 블로그 후기를 불러올 수 없습니다.</p><p style="font-size:12px;margin-top:4px">네이버 API 프록시가 꺼져있을 수 있어요</p></div>';
          }
          if (photos.length) {
            document.getElementById('detail-visitor-photos-container').innerHTML = renderVisitorPhotos(photos);
          }
        }).catch(e => console.warn('Naver fetch error:', e));
      }
    }

    async function loadNearbySpots(currentSpot, typeId) {
      const container = document.getElementById('detail-nearby-carousel');
      container.innerHTML = skeletonCards(4);
      try {
        const all = await fetchSpots(typeId, 30);
        const lat = parseFloat(currentSpot.mapy);
        const lng = parseFloat(currentSpot.mapx);
        if (!lat || !lng) {
          container.innerHTML = '<div class="empty-card">근처 추천 장소를 찾을 수 없습니다.</div>';
          return;
        }
        const nearby = all
          .filter(s => s.contentid !== currentSpot.contentid && parseFloat(s.mapx) && parseFloat(s.mapy))
          .map(s => ({
            ...s,
            distance: Math.sqrt(
              Math.pow(parseFloat(s.mapy) - lat, 2) +
              Math.pow(parseFloat(s.mapx) - lng, 2)
            )
          }))
          .sort((a, b) => a.distance - b.distance)
          .slice(0, 8);
        if (!nearby.length) {
          container.innerHTML = '<div class="empty-card">근처 장소가 없습니다.</div>';
          return;
        }
        container.innerHTML = nearby.map((s, i) => renderCard(s, null, typeId)).join('');
        bindCardClicks();
      } catch (e) {
        console.error(e);
        container.innerHTML = '<div class="empty-card">⚠️ 불러오기 실패</div>';
      }
    }

    // Internal close (called by popstate — no history.back)
    function _closeDetailOverlay() {
      const overlay = document.getElementById('detail-overlay');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
      // Clear dynamic sections
      document.getElementById('detail-gallery-container').innerHTML = '';
      document.getElementById('detail-overview-container').innerHTML = '';
      document.getElementById('detail-intro-container').innerHTML = '';
      document.getElementById('detail-extra-container').innerHTML = '';
      document.getElementById('detail-reviews-container').innerHTML = '';
      document.getElementById('detail-visitor-photos-container').innerHTML = '';
    }
    // Public close (called by UI button — triggers history.back)
    function closeDetailPage() {
      if (document.getElementById('detail-overlay').classList.contains('open')) {
        history.back(); // popstate will call _closeDetailOverlay
      }
    }

    // ============================================
    // === CATEGORY / THEME PAGE ===
    // ============================================
    const THEME_KEYWORDS = {
      '바다힐링': /해변|바다|해수욕|해운대|광안|다대포|송정|이기대|태종대|송도|오륙도/,
      '뉴트로감성': /감천|문화마을|골목|해리|카페|뉴트로|복고|레트로/,
      '야경투어': /야경|타워|대교|광안|전망|불빛|루프탑/,
      '미식여행': /시장|전통|맛집|거리|국밥|밀면|어묵|회|횟집/,
      '산책길': /산책|걷기|둘레길|갈맷길|공원|숲|길/,
      '사진맛집': /공원|전망|포토|문화|카페|뷰|인생/,
      '가족나들이': /공원|놀이|박물관|아쿠아|테마|어린이|동물원|수족관/,
      '커플데이트': /전망|공원|데이트|해변|야경|카페|문화|감성/,
      '혼행': /카페|박물관|공원|골목|문화|서점|사찰/,
    };

    async function openCategoryPage(title, typeId, themeKey) {
      const overlay = document.getElementById('category-overlay');
      const titleEl = document.getElementById('category-title');
      const countEl = document.getElementById('category-count');
      const filterRow = document.getElementById('category-filters');
      const grid = document.getElementById('category-grid');
      const searchInput = document.getElementById('category-search-input');

      titleEl.textContent = title;
      countEl.textContent = '불러오는 중...';
      grid.innerHTML = skeletonCards(12);
      if (searchInput) searchInput.value = '';

      // Build filter chips — highlight matching type
      const filterTypes = ['전체', '관광지', '음식점', '문화시설', '축제/행사', '숙박'];
      const filterTypeMap = { '전체': 'all', '관광지': '12', '음식점': '39', '문화시설': '14', '축제/행사': '15', '숙박': '32' };
      const initialFilter = (typeId && typeId !== 'all') ? typeId : 'all';
      filterRow.innerHTML = filterTypes.map(f => {
        const fVal = filterTypeMap[f];
        const isActive = fVal === initialFilter;
        return `<button class="cat-filter-chip${isActive ? ' active' : ''}" data-filter="${fVal}">${f}</button>`;
      }).join('');

      overlay.classList.add('open');
      overlay.scrollTop = 0;
      document.body.style.overflow = 'hidden';

      // Push history state for browser back button support
      history.pushState({ overlay: 'category' }, '', '#category');

      // Always fetch ALL content types so every filter chip works
      let allSpots = [];
      try {
        const [t12, t39, t14, t15, t32] = await Promise.all([
          fetchSpots('12', 50),
          fetchSpots('39', 50),
          fetchSpots('14', 50),
          fetchSpots('15', 50),
          fetchSpots('32', 50),
        ]);
        allSpots = [
          ...t12.map(s => ({ ...s, contenttypeid: '12' })),
          ...t39.map(s => ({ ...s, contenttypeid: '39' })),
          ...t14.map(s => ({ ...s, contenttypeid: '14' })),
          ...t15.map(s => ({ ...s, contenttypeid: '15' })),
          ...t32.map(s => ({ ...s, contenttypeid: '32' })),
        ].filter(s => parseFloat(s.mapx) && parseFloat(s.mapy));

        // Apply theme keyword filter
        if (themeKey && THEME_KEYWORDS[themeKey]) {
          const re = THEME_KEYWORDS[themeKey];
          const filtered = allSpots.filter(s => re.test(s.title || '') || re.test(s.addr1 || ''));
          if (filtered.length >= 5) allSpots = filtered;
        }

        // Store full data for filtering
        overlay._allSpots = allSpots;

        // Apply initial type filter if specific type was requested
        if (initialFilter !== 'all') {
          const filtered = allSpots.filter(s => String(s.contenttypeid) === initialFilter);
          renderCategoryGrid(filtered);
        } else {
          renderCategoryGrid(allSpots);
        }
      } catch (e) {
        console.error(e);
        grid.innerHTML = '<div class="empty-card">⚠️ 데이터 불러오기 실패</div>';
        countEl.textContent = '';
      }

      // Filter chip events
      filterRow.querySelectorAll('.cat-filter-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          filterRow.querySelectorAll('.cat-filter-chip').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          const filter = chip.dataset.filter;
          const spots = overlay._allSpots || [];
          if (filter === 'all') {
            renderCategoryGrid(spots);
          } else {
            renderCategoryGrid(spots.filter(s => String(s.contenttypeid) === filter));
          }
        });
      });

      // Category search
      const doSearch = () => {
        const q = (searchInput?.value || '').trim().toLowerCase();
        const spots = overlay._allSpots || [];
        // Reset filter chip to '전체'
        filterRow.querySelectorAll('.cat-filter-chip').forEach(c => c.classList.remove('active'));
        filterRow.querySelector('[data-filter="all"]')?.classList.add('active');
        if (!q) {
          renderCategoryGrid(spots);
        } else {
          const filtered = spots.filter(s =>
            (s.title || '').toLowerCase().includes(q) ||
            (s.addr1 || '').toLowerCase().includes(q)
          );
          renderCategoryGrid(filtered);
        }
      };
      if (searchInput) {
        searchInput.onkeydown = e => { if (e.key === 'Enter') doSearch(); };
      }
      const searchBtn = document.getElementById('category-search-btn');
      if (searchBtn) searchBtn.onclick = doSearch;
    }

    function renderCategoryGrid(spots) {
      const grid = document.getElementById('category-grid');
      const countEl = document.getElementById('category-count');
      if (!spots.length) {
        grid.innerHTML = '<div class="empty-card">해당하는 장소가 없습니다.</div>';
        countEl.textContent = '0개';
        return;
      }
      countEl.textContent = `${spots.length}개`;
      grid.innerHTML = spots.map((s, i) =>
        renderCard(s, null, String(s.contenttypeid || '12'))
      ).join('');
      bindCardClicks();
    }

    // Internal close (called by popstate — no history.back)
    function _closeCategoryOverlay() {
      const overlay = document.getElementById('category-overlay');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }
    // Public close (called by UI button — triggers history.back)
    function closeCategoryPage() {
      if (document.getElementById('category-overlay').classList.contains('open')) {
        history.back(); // popstate will call _closeCategoryOverlay
      }
    }

    // === Live Dashboard ===
    async function loadDashboard() {
      const now = new Date();
      const days = ['일', '월', '화', '수', '목', '금', '토'];
      document.getElementById('tile-date').textContent = `${now.getMonth() + 1}/${now.getDate()}`;
      document.getElementById('tile-date-sub').textContent = `${days[now.getDay()]}요일`;

      fetch('https://wttr.in/Busan?format=j1')
        .then(r => r.json())
        .then(data => {
          const cur = data.current_condition?.[0];
          if (!cur) throw new Error('no data');
          const desc = cur.lang_ko?.[0]?.value || cur.weatherDesc?.[0]?.value || '';
          document.getElementById('tile-weather').textContent = `${cur.temp_C}°C`;
          document.getElementById('tile-weather-sub').textContent = desc;
        })
        .catch(() => {
          document.getElementById('tile-weather').textContent = '--°C';
          document.getElementById('tile-weather-sub').textContent = '정보 없음';
        });

      fetch('https://api.sunrise-sunset.org/json?lat=35.1586&lng=129.1603&formatted=0')
        .then(r => r.json())
        .then(data => {
          if (data.status !== 'OK') throw new Error('bad');
          const sunset = new Date(data.results.sunset);
          const hh = String(sunset.getHours()).padStart(2, '0');
          const mm = String(sunset.getMinutes()).padStart(2, '0');
          document.getElementById('tile-sunset').textContent = `${hh}:${mm}`;
        })
        .catch(() => {
          document.getElementById('tile-sunset').textContent = '--:--';
        });

      fetchTodayFestivals()
        .then(festivals => {
          if (festivals.length > 0) {
            const first = festivals[0];
            document.getElementById('tile-festival').textContent = first.title;
            document.getElementById('tile-festival-sub').textContent =
              festivals.length > 1 ? `외 ${festivals.length - 1}건 진행중` : '진행중';
          } else {
            document.getElementById('tile-festival').textContent = '진행중 없음';
            document.getElementById('tile-festival-sub').textContent = '';
          }
        })
        .catch(() => {
          document.getElementById('tile-festival').textContent = '불러오기 실패';
        });
    }

    // === Hero Carousel ===
    let heroIdx = 0;
    let heroTimer = null;
    const heroSlides = document.querySelectorAll('.hero-slide');
    const heroCounter = document.getElementById('hero-counter');
    function initHeroCarousel() {
      const dotsContainer = document.getElementById('hero-dots');
      heroSlides.forEach((_, i) => {
        const dot = document.createElement('div');
        dot.className = 'hero-dot' + (i === 0 ? ' active' : '');
        dot.addEventListener('click', () => goToHero(i));
        dotsContainer.appendChild(dot);
      });
      startHeroAuto();
    }
    function goToHero(i) {
      heroSlides[heroIdx].classList.remove('active');
      document.querySelectorAll('.hero-dot')[heroIdx].classList.remove('active');
      heroIdx = i;
      heroSlides[heroIdx].classList.add('active');
      document.querySelectorAll('.hero-dot')[heroIdx].classList.add('active');
      heroCounter.textContent = `${heroIdx + 1} / ${heroSlides.length}`;
    }
    function startHeroAuto() {
      if (heroTimer) clearInterval(heroTimer);
      heroTimer = setInterval(() => goToHero((heroIdx + 1) % heroSlides.length), 5000);
    }

    // === Roulette ===
    async function runRoulette() {
      const btn = document.getElementById('roulette-btn');
      btn.classList.add('spinning');
      btn.innerHTML = '<span class="icon">🎲</span> <span>돌리는 중...</span>';
      try {
        const [sights, foods, culture] = await Promise.all([
          fetchSpots('12', 30),
          fetchSpots('39', 30),
          fetchSpots('14', 30),
        ]);
        const pickRandom = (arr) => {
          const valid = arr.filter(s => parseFloat(s.mapx) && parseFloat(s.mapy));
          if (!valid.length) return null;
          return valid[Math.floor(Math.random() * valid.length)];
        };
        const candidates = [
          { pick: pickRandom(sights), type: '12' },
          { pick: pickRandom(culture), type: '14' },
          { pick: pickRandom(foods), type: '39' },
        ];
        const course = candidates
          .filter(c => c.pick && c.pick.title)
          .map(c => ({ ...c.pick, contenttypeid: c.type }));
        if (!course.length) throw new Error('코스 생성 실패');
        await new Promise(r => setTimeout(r, 1200));
        openCourseModal(course, '🎰 오늘의 랜덤 추천');
      } catch (e) {
        console.error(e);
        showToast('룰렛 생성 실패 😭 다시 시도해보세요.');
      } finally {
        btn.classList.remove('spinning');
        btn.innerHTML = '<span class="icon">🎲</span> <span>랜덤 코스 뽑기</span>';
      }
    }

    // === Personalized Course Planner (rule-based NLP) ===
    function parseUserQuery(text) {
      const q = text.toLowerCase();
      const result = { days: 1, companion: null, moods: [], transport: null };

      if (/3박|3일|사흘/.test(q)) result.days = 3;
      else if (/2박|2일|이틀/.test(q)) result.days = 2;
      else if (/1박|1일|당일|하루/.test(q)) result.days = 1;

      if (/여친|여자친구|남친|남자친구|커플|데이트|연인/.test(q)) result.companion = '커플';
      else if (/가족|부모|아이|애기|자녀|엄마|아빠/.test(q)) result.companion = '가족';
      else if (/친구|동창|우정/.test(q)) result.companion = '친구';
      else if (/혼자|혼여|솔로/.test(q)) result.companion = '혼자';

      if (/힐링|여유|휴식|쉬|편안/.test(q)) result.moods.push('힐링');
      if (/맛집|먹|음식|맛있|카페|디저트|미식/.test(q)) result.moods.push('맛집');
      if (/야경|밤|이색|로맨틱/.test(q)) result.moods.push('야경');
      if (/바다|해변|해수욕|해운대|광안리/.test(q)) result.moods.push('바다');
      if (/문화|박물관|미술관|전시|역사|뉴트로|감천/.test(q)) result.moods.push('문화');
      if (/뷰|전망|사진|인생샷|감성|포토/.test(q)) result.moods.push('감성');

      if (/뚜벅|걷|도보|대중교통|지하철|버스/.test(q)) result.transport = '뚜벅이';
      else if (/차|자차|운전|렌터카/.test(q)) result.transport = '차량';

      return result;
    }

    async function generateCourseFromQuery(parsed) {
      const totalSpots = parsed.days === 1 ? 4 : parsed.days === 2 ? 6 : 8;
      let typeRatio;
      if (parsed.moods.includes('맛집')) typeRatio = { '12': 0.4, '39': 0.4, '14': 0.2 };
      else if (parsed.moods.includes('문화')) typeRatio = { '12': 0.3, '14': 0.5, '39': 0.2 };
      else typeRatio = { '12': 0.5, '39': 0.3, '14': 0.2 };

      const types = Object.keys(typeRatio);
      const counts = {};
      let remaining = totalSpots;
      types.forEach((t, i) => {
        if (i === types.length - 1) counts[t] = remaining;
        else { counts[t] = Math.max(1, Math.round(totalSpots * typeRatio[t])); remaining -= counts[t]; }
      });

      const fetched = {};
      await Promise.all(types.map(async t => { fetched[t] = await fetchSpots(t, 30); }));

      const picked = [];
      types.forEach(t => {
        const valid = fetched[t].filter(s => parseFloat(s.mapx) && parseFloat(s.mapy));
        const shuffled = [...valid].sort(() => Math.random() - 0.5);
        shuffled.slice(0, counts[t]).forEach(s => picked.push({ ...s, contenttypeid: t }));
      });

      if (picked.length > 1) {
        const sorted = [picked.shift()];
        while (picked.length) {
          const last = sorted[sorted.length - 1];
          const lastLat = parseFloat(last.mapy);
          const lastLng = parseFloat(last.mapx);
          let nearestIdx = 0;
          let nearestDist = Infinity;
          picked.forEach((s, i) => {
            const dLat = parseFloat(s.mapy) - lastLat;
            const dLng = parseFloat(s.mapx) - lastLng;
            const d = dLat * dLat + dLng * dLng;
            if (d < nearestDist) { nearestDist = d; nearestIdx = i; }
          });
          sorted.push(picked.splice(nearestIdx, 1)[0]);
        }
        return sorted;
      }
      return picked;
    }

    function addBotMessage(html) {
      const messages = document.getElementById('chatbot-messages');
      const div = document.createElement('div');
      div.className = 'msg bot';
      div.innerHTML = html;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
      return div;
    }
    function addUserMessage(text) {
      const messages = document.getElementById('chatbot-messages');
      const div = document.createElement('div');
      div.className = 'msg user';
      div.textContent = text;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    async function handleChat(text) {
      if (!text || !text.trim()) return;
      addUserMessage(text);
      document.getElementById('chatbot-input').value = '';
      const loadingMsg = addBotMessage('🤔 부산 코스를 구성 중입니다... 잠시만 기다려주세요!');
      try {
        const parsed = parseUserQuery(text);
        const course = await generateCourseFromQuery(parsed);
        loadingMsg.remove();
        if (!course.length) {
          addBotMessage('죄송합니다, 코스 생성에 실패했습니다. 다른 조건을 입력해보시겠어요?');
          return;
        }
        const summary = [
          parsed.days === 1 ? '당일치기' : `${parsed.days - 1}박 ${parsed.days}일`,
          parsed.companion || '',
          parsed.moods.length ? parsed.moods.join('·') : '',
          parsed.transport || '',
        ].filter(x => x).join(' · ');

        let html = `✅ 코스 준비 완료!<br><strong>${summary}</strong><br>총 <strong>${course.length}곳</strong>을 추천합니다 🌊`;
        course.forEach((s, i) => {
          const typeName = TYPE_NAMES[s.contenttypeid] || '장소';
          html += `<div class="course-item">${i + 1}. <strong>${s.title}</strong> <small>(${typeName})</small></div>`;
        });
        html += '<br>👈 지도와 상세 정보는 넓은 화면으로 띄워드릴게요!';
        addBotMessage(html);
        openCourseModal(course, '🧭 맞춤 추천 코스');
      } catch (e) {
        console.error(e);
        loadingMsg.remove();
        addBotMessage('⚠️ 오류가 발생했습니다. 다시 한번 시도해주세요.');
      }
    }

    // === Course Modal + Map ===
    let modalMap = null;
    let modalMarkersLayer = null;
    let modalRouteLayer = null;
    let currentCourse = [];

    function ensureModalMap() {
      if (modalMap) return;
      modalMap = L.map('modal-map').setView([35.1796, 129.0756], 12);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap',
        maxZoom: 19
      }).addTo(modalMap);
      modalMarkersLayer = L.layerGroup().addTo(modalMap);
      modalRouteLayer = L.layerGroup().addTo(modalMap);
    }

    function createPin(num, color) {
      return L.divIcon({
        html: `<div style="background:${color};color:white;width:30px;height:30px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,0.35);border:2.5px solid white"><span style="transform:rotate(45deg)">${num}</span></div>`,
        className: '',
        iconSize: [30, 30],
        iconAnchor: [15, 30],
        popupAnchor: [0, -30]
      });
    }

    function openCourseModal(course, title) {
      currentCourse = course;
      document.getElementById('modal-title').textContent = title || '추천 코스';
      document.getElementById('modal-backdrop').classList.add('open');

      setTimeout(() => {
        ensureModalMap();
        modalMap.invalidateSize();
        modalMarkersLayer.clearLayers();
        modalRouteLayer.clearLayers();

        const listEl = document.getElementById('modal-course-list');
        listEl.innerHTML = '';
        const bounds = [];
        const coords = [];

        course.forEach((spot, i) => {
          const lat = parseFloat(spot.mapy);
          const lng = parseFloat(spot.mapx);
          if (!lat || !lng) return;
          bounds.push([lat, lng]);
          coords.push([lat, lng]);

          const typeId = String(spot.contenttypeid || '12');
          const color = TYPE_COLORS[typeId] || '#2b96ed';
          const typeName = TYPE_NAMES[typeId] || '장소';

          const marker = L.marker([lat, lng], { icon: createPin(i + 1, color) })
            .addTo(modalMarkersLayer)
            .bindPopup(`<strong>${spot.title}</strong><br><small>${spot.addr1 || ''}</small>`);

          const dialect = pickDialect();
          const img = spot.firstimage || spot.firstimage2 || '';
          const thumb = img
            ? `<img class="thumb" src="${img}" onerror="this.style.display='none'" alt="">`
            : `<div class="thumb" style="display:flex;align-items:center;justify-content:center;font-size:22px">🏝</div>`;
          const item = document.createElement('div');
          item.className = 'course-item-card';
          item.innerHTML = `
            <div class="pin-badge" style="background:${color}">${i + 1}</div>
            <div class="info">
              <div class="name">${spot.title}</div>
              <div class="addr">${spot.addr1 || '주소 정보 없음'} · ${typeName}</div>
              <div class="dialect">💬 ${dialect}</div>
            </div>
            ${thumb}
          `;
          item.addEventListener('click', () => {
            modalMap.setView([lat, lng], 15);
            marker.openPopup();
          });
          listEl.appendChild(item);
        });

        if (coords.length >= 2) {
          L.polyline(coords, { color: '#7c3aed', weight: 4, opacity: 0.75, dashArray: '8, 8' }).addTo(modalRouteLayer);
        }
        if (bounds.length) modalMap.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
      }, 50);
    }

    function closeCourseModal() {
      document.getElementById('modal-backdrop').classList.remove('open');
    }

    function shareCourse() {
      if (!currentCourse.length) { showToast('공유할 코스가 없습니다.'); return; }
      const titles = currentCourse.map((s, i) => `${i+1}. ${s.title}`).join('\n');
      const text = `🗺 어데가노 - 부산 추천 코스\n\n${titles}\n\n#부산여행 #어데가노`;
      if (navigator.share) {
        navigator.share({ title: '어데가노 부산 코스', text }).catch(() => {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(() => showToast('📋 코스가 클립보드에 복사되었습니다!'));
      } else {
        showToast('공유 기능 미지원 브라우저');
      }
    }

    // === Toast ===
    let toastTimer = null;
    function showToast(text) {
      const t = document.getElementById('toast');
      t.textContent = text;
      t.classList.add('show');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => t.classList.remove('show'), 2400);
    }

    function focusGlobalSearch() {
      const input = document.getElementById('global-search');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(() => {
        input.focus();
        input.select();
      }, 180);
    }

    function openCoursePlanner() {
      const panel = document.getElementById('chatbot-panel');
      const fab = document.getElementById('chatbot-fab');
      if (panel.classList.contains('open')) return;
      panel.classList.add('open');
      fab.classList.add('hidden');
      document.getElementById('chatbot-input').focus();
      history.pushState({ overlay: 'chatbot' }, '', '#chat');
      if (!document.querySelector('#chatbot-messages .msg')) {
        addBotMessage('안녕하세요! 부산 코스를 같이 짜드리는 플래너입니다 🧭<br>일정, 동행, 분위기를 알려주시면 맞춤 코스를 추천해드릴게요.');
      }
    }

    // === Event Bindings ===
    document.getElementById('roulette-btn').addEventListener('click', runRoulette);
    document.getElementById('quick-search-btn').addEventListener('click', focusGlobalSearch);
    document.getElementById('quick-course-btn').addEventListener('click', openCoursePlanner);

    // Logo → Home (directly close without triggering extra history.back)
    document.getElementById('logo-home').addEventListener('click', () => {
      _closeDetailOverlay();
      _closeCategoryOverlay();
      document.getElementById('chatbot-panel').classList.remove('open');
      document.getElementById('chatbot-fab').classList.remove('hidden');
      history.replaceState(null, '', window.location.pathname);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Chatbot FAB + Panel
    document.getElementById('chatbot-fab').addEventListener('click', openCoursePlanner);
    document.getElementById('chatbot-close').addEventListener('click', () => {
      if (document.getElementById('chatbot-panel').classList.contains('open')) {
        history.back(); // popstate will handle actual close
      }
    });
    document.getElementById('chatbot-send').addEventListener('click', () => {
      handleChat(document.getElementById('chatbot-input').value);
    });
    document.getElementById('chatbot-input').addEventListener('keydown', e => {
      if (e.key === 'Enter') handleChat(document.getElementById('chatbot-input').value);
    });
    document.getElementById('chatbot-suggestions').addEventListener('click', e => {
      if (e.target.classList.contains('suggestion')) {
        handleChat(e.target.textContent);
      }
    });

    // Mood chips
    document.getElementById('mood-chips').addEventListener('click', e => {
      const chip = e.target.closest('.mood-chip');
      if (!chip) return;
      document.querySelectorAll('.mood-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentMood = chip.dataset.mood;
      loadRanking();
      document.getElementById('ranking-title').textContent =
        currentMood === 'all' ? '🔥 지금 가장 핫한 부산' : `✨ ${chip.textContent.trim()} 추천`;
    });

    // Nav tabs → open category page
    document.querySelectorAll('.nav-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentTypeTab = tab.dataset.tab;
        if (currentTypeTab === 'home') {
          closeDetailPage();
          closeCategoryPage();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else if (currentTypeTab === 'planner') {
          openCoursePlanner();
          tab.classList.remove('active');
          document.querySelector('.nav-tab[data-tab="home"]').classList.add('active');
          currentTypeTab = 'home';
        } else if (currentTypeTab === 'roulette') {
          runRoulette();
          tab.classList.remove('active');
          document.querySelector('.nav-tab[data-tab="home"]').classList.add('active');
          currentTypeTab = 'home';
        } else {
          const typeNames = { '12': '🏝 부산 관광지', '39': '🍜 부산 맛집', '15': '🎪 부산 축제', '32': '🏨 부산 숙박', '14': '🎨 부산 문화시설' };
          const title = typeNames[currentTypeTab] || '추천';
          openCategoryPage(title, currentTypeTab, null);
        }
      });
    });

    // Theme tiles → open themed category page
    document.getElementById('theme-tiles').addEventListener('click', e => {
      const tile = e.target.closest('.theme-tile');
      if (!tile) return;
      const themeKey = tile.dataset.theme;
      const themeLabel = tile.querySelector('.theme-tile-label').textContent;
      const themeIcon = tile.dataset.icon || '🏝';
      openCategoryPage(`${themeIcon} ${themeLabel} 여행`, 'all', themeKey);
    });

    // See more buttons
    document.getElementById('ranking-more').addEventListener('click', () => {
      openCategoryPage('🔥 핫한 부산 장소', '12', null);
    });
    document.querySelectorAll('[data-see-more]').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.seeMore;
        if (key === 'beach') openCategoryPage('🌊 바다가 부른다', '12', '바다힐링');
        else if (key === 'food') openCategoryPage('🍜 부산 미식 로드', '39', null);
        else if (key === 'accommodation') openCategoryPage('🏨 부산 숙박', '32', null);
        else if (key === 'festival') openCategoryPage('🎪 지금 열리는 축제', '15', null);
      });
    });

    // Detail page - Tab navigation
    document.querySelectorAll('.detail-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.target;
        const target = document.getElementById(targetId);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        document.querySelectorAll('.detail-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
      });
    });

    // Detail page - Scroll spy for tabs + header title
    const detailOverlay = document.getElementById('detail-overlay');
    detailOverlay.addEventListener('scroll', () => {
      const scrollTop = detailOverlay.scrollTop;
      // Show/hide header title
      const headerTitle = document.getElementById('detail-header-title');
      if (scrollTop > 300) {
        headerTitle.classList.add('visible');
      } else {
        headerTitle.classList.remove('visible');
      }
      // Update active tab based on scroll position
      const sections = detailOverlay.querySelectorAll('[data-detail-section]');
      let activeId = null;
      sections.forEach(sec => {
        const rect = sec.getBoundingClientRect();
        if (rect.top <= 180) activeId = sec.id;
      });
      if (activeId) {
        document.querySelectorAll('.detail-tab').forEach(t => {
          t.classList.toggle('active', t.dataset.target === activeId);
        });
      }
    });

    document.getElementById('detail-back').addEventListener('click', closeDetailPage);
    document.getElementById('detail-share-btn').addEventListener('click', () => {
      const title = document.getElementById('detail-title').textContent;
      const addr = document.getElementById('detail-addr').textContent;
      const text = `🗺 어데가노 추천\n\n📍 ${title}\n${addr}\n\n#부산여행 #어데가노`;
      if (navigator.share) {
        navigator.share({ title: `어데가노 - ${title}`, text }).catch(() => {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(() => showToast('📋 상세 정보가 클립보드에 복사되었습니다!'));
      }
    });
    document.getElementById('detail-addr-copy').addEventListener('click', () => {
      const addr = document.getElementById('detail-addr').textContent;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(addr).then(() => showToast('📋 주소가 클립보드에 복사되었습니다!'));
      }
    });

    // Category page
    document.getElementById('category-back').addEventListener('click', closeCategoryPage);

    // Modal
    document.getElementById('modal-close').addEventListener('click', closeCourseModal);
    document.getElementById('modal-backdrop').addEventListener('click', e => {
      if (e.target.id === 'modal-backdrop') closeCourseModal();
    });
    document.getElementById('btn-share').addEventListener('click', shareCourse);
    document.getElementById('btn-map-expand').addEventListener('click', () => {
      if (modalMap) { modalMap.invalidateSize(); showToast('지도 새로고침 완료!'); }
    });

    // Global search → fetch keyword results and show in category overlay
    async function runGlobalSearch() {
      const q = document.getElementById('global-search').value.trim();
      if (!q) return;

      // Open overlay immediately with loading state
      const overlay = document.getElementById('category-overlay');
      const titleEl = document.getElementById('category-title');
      const countEl = document.getElementById('category-count');
      const filterRow = document.getElementById('category-filters');
      const grid = document.getElementById('category-grid');
      const searchInput = document.getElementById('category-search-input');

      titleEl.textContent = `🔍 "${q}" 검색 결과`;
      countEl.textContent = '검색 중...';
      filterRow.innerHTML = '';
      grid.innerHTML = skeletonCards(8);
      if (searchInput) searchInput.value = q;

      overlay.classList.add('open');
      overlay.scrollTop = 0;
      document.body.style.overflow = 'hidden';
      history.pushState({ overlay: 'category' }, '', '#category');

      try {
        const items = await fetchKeywordSearch(q);
        overlay._allSpots = items;
        renderCategoryGrid(items);
      } catch (e) {
        grid.innerHTML = '<div class="empty-card">⚠️ 검색 결과를 불러오지 못했어요.</div>';
        countEl.textContent = '';
      }
    }
    document.getElementById('global-search-btn').addEventListener('click', runGlobalSearch);
    document.getElementById('global-search').addEventListener('keydown', e => {
      if (e.key === 'Enter') runGlobalSearch();
    });

    // Keyboard: Escape to close overlays
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        if (document.getElementById('detail-overlay').classList.contains('open')) {
          closeDetailPage();
        } else if (document.getElementById('category-overlay').classList.contains('open')) {
          closeCategoryPage();
        } else if (document.getElementById('modal-backdrop').classList.contains('open')) {
          closeCourseModal();
        }
      }
    });


    // === Carousel Navigation Arrows ===
    function initCarouselArrows() {
      document.querySelectorAll('.carousel-wrap').forEach(wrap => {
        const carousel = wrap.querySelector('.card-carousel');
        const prevBtn = wrap.querySelector('.carousel-arrow.prev');
        const nextBtn = wrap.querySelector('.carousel-arrow.next');
        if (!carousel || !prevBtn || !nextBtn) return;

        const updateArrows = () => {
          const maxScrollLeft = carousel.scrollWidth - carousel.clientWidth;
          if (carousel.scrollLeft > 10) prevBtn.classList.add('visible');
          else prevBtn.classList.remove('visible');
          
          if (carousel.scrollLeft < maxScrollLeft - 10) nextBtn.classList.add('visible');
          else nextBtn.classList.remove('visible');
        };

        // Initialize visibility
        updateArrows();
        carousel.addEventListener('scroll', updateArrows);
        window.addEventListener('resize', updateArrows);

        // We also need to update arrows when data is loaded and DOM changes
        const observer = new MutationObserver(updateArrows);
        observer.observe(carousel, { childList: true, subtree: true });

        // Scroll Actions
        const scrollAmount = 260 + 16; // Card width + gap
        prevBtn.addEventListener('click', () => {
          carousel.scrollBy({ left: -scrollAmount * 2, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', () => {
          carousel.scrollBy({ left: scrollAmount * 2, behavior: 'smooth' });
        });
      });
    }
    
    initCarouselArrows();

    // === History API: Browser back button support ===
    window.addEventListener('popstate', (e) => {
      const state = e.state;
      const detailOpen = document.getElementById('detail-overlay').classList.contains('open');
      const categoryOpen = document.getElementById('category-overlay').classList.contains('open');
      const chatOpen = document.getElementById('chatbot-panel').classList.contains('open');

      // Close the topmost overlay
      if (detailOpen) {
        _closeDetailOverlay();
      } else if (categoryOpen) {
        _closeCategoryOverlay();
      } else if (chatOpen) {
        document.getElementById('chatbot-panel').classList.remove('open');
        document.getElementById('chatbot-fab').classList.remove('hidden');
      }

      // Clean up hash
      if (!state || !state.overlay) {
        if (window.location.hash) {
          history.replaceState(null, '', window.location.pathname);
        }
      }
    });

    // On page load, clean up stale hash from previous session
    if (window.location.hash) {
      history.replaceState(null, '', window.location.pathname);
    }

    // === Hero: load real TourAPI images ===
    async function loadHeroImages() {
      try {
        const items = await fetchSpots('12', 50);
        const withImg = items.filter(s => s.firstimage);
        if (!withImg.length) return;
        const slides = document.querySelectorAll('.hero-slide');
        slides.forEach((slide, i) => {
          const spot = withImg[i % withImg.length];
          slide.style.backgroundImage = `url('${spot.firstimage}')`;
          const h1 = slide.querySelector('h1');
          const p = slide.querySelector('p');
          if (h1) h1.textContent = spot.title;
          if (p) p.textContent = spot.addr1 || '부산광역시';
        });
      } catch (e) {
        // fallback: keep static Unsplash images
      }
    }

    const STYLE_TITLES = [
      { match: { travelStyle: 'healing', tags: ['beach'] }, title: '바다힐링러', emoji: '🌊' },
      { match: { travelStyle: 'healing', tags: ['night-view'] }, title: '야경 산책러', emoji: '🌃' },
      { match: { travelStyle: 'foodie', tags: ['food'] }, title: '부산 미식 탐험가', emoji: '🍜' },
      { match: { travelStyle: 'foodie', tags: ['retro'] }, title: '뉴트로 감성 미식러', emoji: '🎨' },
      { match: { travelStyle: 'active', tags: ['beach'] }, title: '액티브 바다러', emoji: '🏄' },
      { match: { travelStyle: 'active', tags: ['photo-spot'] }, title: '모험 포토그래퍼', emoji: '📸' },
      { match: { travelStyle: 'culture', tags: ['retro'] }, title: '문화 감성러', emoji: '🏛' },
      { match: { travelStyle: 'culture', tags: ['family'] }, title: '가족 문화 여행자', emoji: '👨‍👩‍👧' },
      { match: { travelStyle: 'photo', tags: ['photo-spot'] }, title: '인생샷 헌터', emoji: '📷' },
      { match: {}, title: '부산 여행자', emoji: '🗺️' }
    ];
    const onbStorageKey = 'odga.onboarding.v1';
    const onbStepOrder = ['intro', 'style', 'companion', 'duration', 'region', 'interest', 'nickname', 'result'];
    const onbProgressOrder = ['style', 'companion', 'duration', 'region', 'interest', 'nickname', 'result'];
    const onbInterestToMood = {
      beach: '바다',
      'night-view': '야경',
      retro: '뉴트로',
      food: '맛집',
      'photo-spot': '감성',
      family: '가족',
      couple: '커플',
      solo: '혼자'
    };
    const onbTravelStyleLabels = {
      healing: '힐링',
      active: '액티브',
      foodie: '미식',
      culture: '문화',
      photo: '사진'
    };
    const onbCompanionLabels = {
      solo: '혼자',
      couple: '커플',
      family: '가족',
      friends: '친구들'
    };
    const onbDurationLabels = {
      dayTrip: '당일치기',
      '1n2d': '1박 2일',
      '2n3d': '2박 3일',
      longer: '3박 이상'
    };
    const onbRegionLabels = {
      haeundae: '해운대',
      gwangalli: '광안리',
      nampo: '남포동',
      seomyeon: '서면',
      taejongdae: '태종대',
      gamcheon: '감천문화마을',
      beomeosa: '범어사',
      gijang: '기장',
      songdo: '송도',
      yeongdo: '영도',
      'busan-station': '부산역',
      centum: '센텀',
      dongnae: '동래'
    };
    const onbInterestLabels = {
      beach: '바다',
      'night-view': '야경',
      retro: '뉴트로',
      food: '맛집',
      'photo-spot': '사진맛집',
      family: '가족',
      couple: '커플',
      solo: '혼행',
      shopping: '쇼핑',
      cafe: '카페',
      nature: '자연'
    };
    let onbDraft = onbCreateDraft();
    let onbCurrentStep = 0;
    let onbInitialized = false;
    let onbLastActiveElement = null;

    function onbCreateDraft(onbSource = {}) {
      return {
        version: 1,
        skipped: Boolean(onbSource.skipped),
        completedAt: onbSource.completedAt || null,
        travelStyle: onbSource.travelStyle || '',
        companion: onbSource.companion || '',
        duration: onbSource.duration || '',
        regions: Array.isArray(onbSource.regions) ? [...onbSource.regions] : [],
        interests: Array.isArray(onbSource.interests) ? [...onbSource.interests] : [],
        nickname: onbSource.nickname || ''
      };
    }

    function onbReadStorage() {
      try {
        const onbRaw = localStorage.getItem(onbStorageKey);
        if (!onbRaw) return null;
        return onbCreateDraft(JSON.parse(onbRaw));
      } catch (error) {
        console.warn('온보딩 데이터를 읽지 못했습니다.', error);
        return null;
      }
    }

    function onbWriteStorage(onbData) {
      localStorage.setItem(onbStorageKey, JSON.stringify(onbData));
    }

    function onbGetTitleConfig(onbData) {
      return STYLE_TITLES.find((onbItem) => {
        if (!onbItem.match.travelStyle && !onbItem.match.tags) return true;
        if (onbItem.match.travelStyle && onbItem.match.travelStyle !== onbData.travelStyle) return false;
        if (onbItem.match.tags && onbItem.match.tags.length) {
          return onbItem.match.tags.some((onbTag) => onbData.interests.includes(onbTag));
        }
        return true;
      }) || STYLE_TITLES[STYLE_TITLES.length - 1];
    }

    function onbGetStepIndex(onbStepName) {
      return onbStepOrder.indexOf(onbStepName);
    }

    function onbGetProgressText(onbStepName) {
      const onbIndex = onbProgressOrder.indexOf(onbStepName);
      if (onbIndex === -1) return '';
      return `${onbIndex + 1}/${onbProgressOrder.length}`;
    }

    function onbGetFocusable() {
      const onbOverlay = document.getElementById('onb-overlay');
      if (!onbOverlay || onbOverlay.hidden) return [];
      return Array.from(onbOverlay.querySelectorAll('button:not([disabled]), input:not([disabled])')).filter((onbElement) => !onbElement.hidden && onbElement.offsetParent !== null);
    }

    function onbCloseOverlay() {
      const onbOverlay = document.getElementById('onb-overlay');
      if (!onbOverlay) return;
      onbOverlay.hidden = true;
      onbOverlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('onb-open');
      if (onbLastActiveElement && typeof onbLastActiveElement.focus === 'function') {
        onbLastActiveElement.focus();
      }
    }

    function onbRenderSelectionState() {
      document.querySelectorAll('[data-onb-single]').forEach((onbButton) => {
        const onbField = onbButton.dataset.onbSingle;
        const onbSelected = onbDraft[onbField] === onbButton.dataset.value;
        onbButton.dataset.selected = onbSelected ? 'true' : 'false';
        onbButton.setAttribute('aria-pressed', onbSelected ? 'true' : 'false');
      });

      document.querySelectorAll('[data-region]').forEach((onbChip) => {
        const onbSelected = onbDraft.regions.includes(onbChip.dataset.region);
        onbChip.dataset.selected = onbSelected ? 'true' : 'false';
        onbChip.setAttribute('aria-pressed', onbSelected ? 'true' : 'false');
      });

      document.querySelectorAll('[data-interest]').forEach((onbChip) => {
        const onbSelected = onbDraft.interests.includes(onbChip.dataset.interest);
        onbChip.dataset.selected = onbSelected ? 'true' : 'false';
        onbChip.setAttribute('aria-pressed', onbSelected ? 'true' : 'false');
      });

      const onbNicknameInput = document.getElementById('onb-nickname');
      if (onbNicknameInput) onbNicknameInput.value = onbDraft.nickname || '';
      document.getElementById('onb-region-summary').textContent = `선택: ${onbDraft.regions.length}개`;
      document.getElementById('onb-interest-summary').textContent = `선택: ${onbDraft.interests.length}개`;
    }

    function onbUpdateNextState() {
      const onbNext = document.getElementById('onb-next');
      const onbStepName = onbStepOrder[onbCurrentStep];
      let onbEnabled = false;

      if (onbStepName === 'style') {
        onbEnabled = Boolean(onbDraft.travelStyle);
      } else if (onbStepName === 'companion') {
        onbEnabled = Boolean(onbDraft.companion);
      } else if (onbStepName === 'duration') {
        onbEnabled = Boolean(onbDraft.duration);
      } else if (onbStepName === 'region') {
        onbEnabled = onbDraft.regions.length >= 1 && onbDraft.regions.length <= 5;
      } else if (onbStepName === 'interest') {
        onbEnabled = onbDraft.interests.length >= 1 && onbDraft.interests.length <= 5;
      } else if (onbStepName === 'nickname') {
        onbEnabled = true;
      }

      onbNext.disabled = !onbEnabled;
    }

    function onbUpdateResultCard() {
      const onbTitleConfig = onbGetTitleConfig(onbDraft);
      const onbName = onbDraft.nickname ? `${onbDraft.nickname}님의 부산 스타일` : '당신의 부산 스타일';
      const onbRegionText = onbDraft.regions.slice(0, 3).map((onbKey) => onbRegionLabels[onbKey] || onbKey).join(' · ');
      const onbInfo = [
        `${onbCompanionLabels[onbDraft.companion] || '함께'} · ${onbDurationLabels[onbDraft.duration] || '일정 미정'}`,
        onbRegionText || '부산 전역 추천'
      ].join('<br />');

      document.getElementById('onb-result-avatar').textContent = onbTitleConfig.emoji;
      document.getElementById('onb-result-name').textContent = onbName;
      document.getElementById('onb-result-title').textContent = onbTitleConfig.title;
      document.getElementById('onb-result-info').innerHTML = onbInfo;
      document.getElementById('onb-result-tags').innerHTML = onbDraft.interests.slice(0, 5).map((onbInterest) => (
        `<span class="onb-result-tag">${onbInterestLabels[onbInterest] || onbInterest}</span>`
      )).join('');
    }

    function onbUpdateChrome() {
      const onbOverlay = document.getElementById('onb-overlay');
      const onbProgressWrap = document.getElementById('onb-progress-wrap');
      const onbProgressDots = document.getElementById('onb-progress-dots');
      const onbFooter = document.getElementById('onb-footer');
      const onbBack = document.getElementById('onb-back');
      const onbProgressText = document.getElementById('onb-progress-text');
      const onbStepName = onbStepOrder[onbCurrentStep];
      const onbIsIntro = onbStepName === 'intro';
      const onbIsResult = onbStepName === 'result';
      const onbProgressIndex = onbProgressOrder.indexOf(onbStepName);

      onbProgressWrap.hidden = onbIsIntro;
      onbProgressDots.hidden = onbIsIntro;
      onbFooter.hidden = onbIsIntro || onbIsResult;
      onbBack.hidden = onbCurrentStep <= 1;
      onbProgressText.textContent = onbGetProgressText(onbStepName);
      onbProgressDots.innerHTML = onbProgressOrder.map((onbName, onbIndex) => (
        `<span class="onb-dot${onbIndex <= onbProgressIndex ? ' active' : ''}"></span>`
      )).join('');
      onbOverlay.querySelector('.onb-container').setAttribute('aria-labelledby', `onb-title-${onbStepName}`);
      onbUpdateNextState();
    }

    function onbToggleMulti(onbField, onbValue, onbLimit) {
      const onbList = onbField === 'regions' ? onbDraft.regions : onbDraft.interests;
      const onbIndex = onbList.indexOf(onbValue);
      if (onbIndex >= 0) {
        onbList.splice(onbIndex, 1);
      } else if (onbList.length < onbLimit) {
        onbList.push(onbValue);
      }
      onbRenderSelectionState();
      onbUpdateNextState();
    }

    function goToStep(onbNextStep, onbOptions = {}) {
      const onbStep = Math.max(0, Math.min(onbNextStep, onbStepOrder.length - 1));
      onbCurrentStep = onbStep;
      const onbStepName = onbStepOrder[onbCurrentStep];

      document.querySelectorAll('.onb-step').forEach((onbPanel) => {
        onbPanel.hidden = onbPanel.dataset.step !== onbStepName;
      });

      if (onbStepName === 'result') {
        onbUpdateResultCard();
      }

      onbUpdateChrome();

      if (!onbOptions.fromPop) {
        history.pushState({ onb: true, onbStep: onbCurrentStep }, '', window.location.pathname + window.location.search);
      }

      const onbFocusable = onbGetFocusable();
      if (onbFocusable[0]) onbFocusable[0].focus();
    }

    function openOnboarding(onbNextDraft = onbCreateDraft(onbReadStorage() || {}), onbInitialStep = 0) {
      const onbOverlay = document.getElementById('onb-overlay');
      onbLastActiveElement = document.activeElement;
      onbDraft = onbCreateDraft(onbNextDraft);
      onbRenderSelectionState();
      onbOverlay.hidden = false;
      onbOverlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('onb-open');
      history.pushState({ onb: true, onbStep: onbInitialStep }, '', window.location.pathname + window.location.search);
      goToStep(onbInitialStep, { fromPop: true });
    }

    function finishOnboarding(onbPayload) {
      const onbCompleted = onbPayload && onbPayload.skipped ? onbCreateDraft({
        version: 1,
        skipped: true,
        completedAt: null
      }) : onbCreateDraft({
        ...onbPayload,
        version: 1,
        skipped: false,
        completedAt: new Date().toISOString()
      });

      onbWriteStorage(onbCompleted);
      onbCloseOverlay();

      if (onbCompleted.skipped) {
        document.getElementById('my-style-card').hidden = true;
        return;
      }

      renderMyStyleCard();
      applyPreferencesToHome();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderMyStyleCard() {
      const onbStored = onbReadStorage();
      const onbSection = document.getElementById('my-style-card');
      if (!onbStored || onbStored.skipped || !onbStored.completedAt) {
        onbSection.hidden = true;
        return;
      }

      const onbTitleConfig = onbGetTitleConfig(onbStored);
      const onbName = onbStored.nickname ? `${onbStored.nickname}님에게 어울리는 부산 무드예요.` : '선호도에 맞춘 부산 여행 스타일이에요.';
      const onbTagItems = [
        onbTravelStyleLabels[onbStored.travelStyle],
        onbCompanionLabels[onbStored.companion],
        onbDurationLabels[onbStored.duration],
        ...onbStored.interests.slice(0, 3).map((onbInterest) => onbInterestLabels[onbInterest])
      ].filter(Boolean).slice(0, 5);

      document.getElementById('my-style-avatar').textContent = onbTitleConfig.emoji;
      document.getElementById('my-style-title').textContent = onbTitleConfig.title;
      document.getElementById('my-style-desc').textContent = onbName;
      document.getElementById('my-style-tags').innerHTML = onbTagItems.map((onbTag) => `<span class="my-style-tag">${onbTag}</span>`).join('');
      onbSection.hidden = false;
    }

    function applyPreferencesToHome() {
      const onbStored = onbReadStorage();
      if (!onbStored || onbStored.skipped || !onbStored.completedAt) return;

      const onbMood = onbStored.interests.map((onbInterest) => onbInterestToMood[onbInterest]).find(Boolean) || 'all';
      const onbChips = Array.from(document.querySelectorAll('#mood-chips .mood-chip'));
      const onbTargetChip = onbChips.find((onbChip) => onbChip.dataset.mood === onbMood);
      onbChips.forEach((onbChip) => onbChip.classList.remove('active'));

      if (onbTargetChip) {
        onbTargetChip.classList.add('active');
        currentMood = onbTargetChip.dataset.mood;
      } else {
        const onbDefaultChip = onbChips.find((onbChip) => onbChip.dataset.mood === 'all');
        if (onbDefaultChip) onbDefaultChip.classList.add('active');
        currentMood = 'all';
      }

      const onbActiveChip = document.querySelector('#mood-chips .mood-chip.active');
      document.getElementById('ranking-title').textContent = currentMood === 'all'
        ? '🔥 지금 가장 핫한 부산'
        : `✨ ${onbActiveChip.textContent.trim()} 추천`;
      loadRanking();
    }

    function initOnboarding() {
      if (onbInitialized) return;
      onbInitialized = true;

      document.getElementById('onb-start').addEventListener('click', () => goToStep(onbGetStepIndex('style')));
      document.getElementById('onb-later').addEventListener('click', () => finishOnboarding({ skipped: true }));
      document.getElementById('onb-skip').addEventListener('click', () => finishOnboarding({ skipped: true }));
      document.getElementById('onb-back').addEventListener('click', () => {
        if (onbCurrentStep > 0) goToStep(onbCurrentStep - 1);
      });
      document.getElementById('onb-next').addEventListener('click', () => {
        if (onbStepOrder[onbCurrentStep] === 'nickname') {
          goToStep(onbGetStepIndex('result'));
          return;
        }
        goToStep(onbCurrentStep + 1);
      });
      document.getElementById('onb-finish').addEventListener('click', () => finishOnboarding(onbDraft));
      document.getElementById('onb-restart').addEventListener('click', () => {
        onbDraft = onbCreateDraft();
        onbRenderSelectionState();
        goToStep(onbGetStepIndex('style'));
      });
      document.getElementById('my-style-reset').addEventListener('click', () => openOnboarding(onbReadStorage() || onbCreateDraft(), onbGetStepIndex('style')));

      document.querySelectorAll('[data-onb-single]').forEach((onbButton) => {
        onbButton.addEventListener('click', () => {
          const onbField = onbButton.dataset.onbSingle;
          onbDraft[onbField] = onbButton.dataset.value;
          onbRenderSelectionState();
          onbUpdateNextState();
        });
      });

      document.querySelectorAll('[data-region]').forEach((onbButton) => {
        onbButton.addEventListener('click', () => onbToggleMulti('regions', onbButton.dataset.region, 5));
      });

      document.querySelectorAll('[data-interest]').forEach((onbButton) => {
        onbButton.addEventListener('click', () => onbToggleMulti('interests', onbButton.dataset.interest, 5));
      });

      document.getElementById('onb-nickname').addEventListener('input', (onbEvent) => {
        onbDraft.nickname = onbEvent.target.value.trim();
      });

      document.addEventListener('keydown', (onbEvent) => {
        const onbOverlay = document.getElementById('onb-overlay');
        if (onbOverlay.hidden) return;

        if (onbEvent.key === 'Tab') {
          const onbFocusable = onbGetFocusable();
          if (!onbFocusable.length) return;
          const onbFirst = onbFocusable[0];
          const onbLast = onbFocusable[onbFocusable.length - 1];
          if (onbEvent.shiftKey && document.activeElement === onbFirst) {
            onbEvent.preventDefault();
            onbLast.focus();
          } else if (!onbEvent.shiftKey && document.activeElement === onbLast) {
            onbEvent.preventDefault();
            onbFirst.focus();
          }
        }

        if (onbEvent.key === 'Escape') {
          if (onbCurrentStep === 0 || onbStepOrder[onbCurrentStep] === 'result') {
            finishOnboarding({ skipped: true });
          } else if (window.confirm('지금 닫으면 입력 중인 내용이 저장되지 않을 수 있어요. 닫으시겠어요?')) {
            finishOnboarding({ skipped: true });
          }
        }
      });

      window.addEventListener('popstate', (onbEvent) => {
        const onbOverlay = document.getElementById('onb-overlay');
        if (onbOverlay.hidden) return;
        if (onbEvent.state && onbEvent.state.onb === true && typeof onbEvent.state.onbStep === 'number') {
          goToStep(onbEvent.state.onbStep, { fromPop: true });
          return;
        }
        if (onbCurrentStep > 0) {
          goToStep(onbCurrentStep - 1, { fromPop: true });
          return;
        }
        onbCloseOverlay();
      });

      const onbStored = onbReadStorage();
      if (onbStored && !onbStored.skipped && onbStored.completedAt) {
        renderMyStyleCard();
        applyPreferencesToHome();
        return;
      }
      if (!onbStored || (!onbStored.skipped && !onbStored.completedAt)) {
        openOnboarding(onbStored || onbCreateDraft(), 0);
      }
    }

    // === Init ===
    document.addEventListener('DOMContentLoaded', initOnboarding);
    initHeroCarousel();
    loadHeroImages();
    loadDashboard();
    loadRanking();
    loadBeachSection();
    loadFoodSection();
    loadAccommodationSection();
    loadFestivalSection();
  </script>
</body>
</html>
